# large upstream clones (pinned versions are recorded in record/)
/linux-hardened
/linux-firmware

# downloads and staging
/stage

# disk images, VM state, build output
*.img
*.iso
*.qcow2
*.fd
*.tar.gz
*.tar.xz
*.tar.zst
*.log

# keys and secrets - never commit
*.pem
*.key
*.x509
*.p12
*.pfx
*.gpg
# public signing keys of upstream projects (checked: no secret packets) - gpgv verifies against them
!/keys/*.gpg
*.kbx
signing_key*
x509.genkey
secring*
private-keys-v1.d/
.gnupg/
.env
.env.*
*.secret
id_rsa*
id_ed25519*
wpa_supplicant-*.conf

# AI assistant files (local working notes, not part of the distribution)
CLAUDE*.md
CLAUDE.local.md
HANDOFF.md
.claude/
.mcp.json
AGENTS.md
GEMINI.md
.gemini/
.codex/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md

# editor and OS junk
*~
*.swp
*.swo
.*.swp
.DS_Store
.vscode/
.idea/

# smoke (C) build output
/src/smoke/*.o
/src/smoke/smoke

# media build (scripts/build-media.sh): staging, media kernel, firmware
/media-build

# C build output (src/smoke, src/installer, src/pixel)
src/*/*.o
src/installer/cig-install
src/smoke/smoke
src/pixel/pixel
