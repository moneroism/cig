# fastfetch - system information
name=fastfetch
version=2.69.0
rel=4
source="fastfetch-$version.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz"
sha256="d0e42faf307e39e7b531d632745a56e4eb558a6545f557280099c622562355ee"
makedepends="cmake make"
style=custom
group="tools"
do_build() {
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=OFF -DBUILD_FLASHFETCH=OFF
    make -C build
}
config_files="etc/xdg/fastfetch/config.jsonc etc/profile.d/fastfetch.sh"
# cig's logos (assets/logos) as a system-wide default; ~/.config/fastfetch overrides it.
# The braille logo needs a graphical terminal: the Linux console gets the ASCII one.
do_install() {
    make -C build DESTDIR="$DEST" install
    mkdir -p "$DEST/usr/share/fastfetch/logos/cig" "$DEST/etc/xdg/fastfetch" "$DEST/etc/profile.d"
    install -m 644 "$CIG_REPO"/assets/logos/*.txt "$DEST/usr/share/fastfetch/logos/cig/"
    # a config file replaces fastfetch's defaults, so the modules are listed too
    printf '%s\n' '{' \
        '    "logo": { "type": "file", "source": "/usr/share/fastfetch/logos/cig/cig.txt",' \
        '              "color": { "1": "38;5;255", "2": "38;5;202", "3": "38;5;245",' \
        '                         "4": "38;5;180", "5": "38;5;240", "6": "38;5;220" } },' \
        '    "modules": ["title", "separator", "os", "kernel", "uptime", "packages", "shell", "wm",' \
        '                "terminal", "cpu", "gpu", "memory", "swap", "disk", "break", "colors"]' '}' \
        > "$DEST/etc/xdg/fastfetch/config.jsonc"
    printf '%s\n' '# the Linux console has no braille: show the ASCII logo there' \
        'if [ "$TERM" = linux ]; then' \
        '    alias fastfetch="fastfetch --logo-type file --logo /usr/share/fastfetch/logos/cig/cig-ascii.txt"' 'fi' \
        > "$DEST/etc/profile.d/fastfetch.sh"
}
