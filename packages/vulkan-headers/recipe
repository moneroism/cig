# vulkan-headers - Vulkan API headers (to build the Vulkan loader and Vulkan programs)
name=vulkan-headers
version=1.4.365
source="vulkan-headers-$version.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v$version.tar.gz"
sha256="ed832b3292cce324ebba6522fd2d3004bf1b797fa49bfbcad0b302ff23d56abc"
makedepends="cmake make"
style=custom
do_build() { cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DVULKAN_HEADERS_ENABLE_MODULE=OFF -DBUILD_TESTS=OFF; }
do_install() { make -C build DESTDIR="$DEST" install; }
