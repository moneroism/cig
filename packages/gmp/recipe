# gmp - arbitrary precision arithmetic. Needed for GCC plugin headers
# (the kernel's hardening plugins: latent_entropy, stackleak, randstruct).
name=gmp
version=6.3.0
source="https://ftp.gnu.org/gnu/gmp/gmp-$version.tar.xz"
signature="https://ftp.gnu.org/gnu/gmp/gmp-$version.tar.xz.sig"
keys="343C2FF0FBEE5EC2EDBEF399F3599FF828C67298"
sha256="-"
style=custom
# gmp 6.3.0's configure tests use pre-C23 code; GCC 15+ defaults to C23.
# --enable-fat: runtime CPU detection instead of tuning for the build machine.
do_build() {
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --disable-static --enable-fat
    make
}
do_install() { make DESTDIR="$DEST" install; }
