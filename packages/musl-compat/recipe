# musl-compat - small glibc-compatibility headers some software expects:
# <error.h> and <sys/cdefs.h>. Written for cig; no upstream source.
name=musl-compat
version=1
source=""
sha256=""
style=custom
do_build() { :; }
do_install() {
    install -D -m 644 "$PKGDIR/files/error.h" "$DEST/usr/include/error.h"
    install -D -m 644 "$PKGDIR/files/cdefs.h" "$DEST/usr/include/sys/cdefs.h"
}
