# python-packaging - version handling (needed to build Mesa) (Python module, a build tool: installed as plain files, no pip)
name=python-packaging
version=26.4
license="Apache-2.0 OR BSD-2-Clause"
source="https://files.pythonhosted.org/packages/c3/75/ffb1dc0ed12352139fb4ca0e3fde4325a23e3d0f3f40efe89717bc4f557b/packaging-$version.tar.gz"
sha256="c4b671c41ddb9bf26e543c37723610d28fb6bf7affc4da17cf048d419d2c062a"
depends="python"
style=custom
do_build() { :; }
do_install() {
    local site
    site=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    mkdir -p "$DEST$site"
    cp -a src/packaging "$DEST$site/"
    find "$DEST$site" \( -name '*.c' -o -name '*.pyi' -o -name __pycache__ \) -prune -exec rm -rf {} +
}
