#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# cig-kernel-install [version] - put a built kernel on the EFI system partition.
#   /boot/EFI/BOOT/BOOTX64.EFI      the kernel: the path every UEFI firmware finds, also
#                                   without a boot entry (some find no other path)
#   /boot/EFI/cig/vmlinuz-old.efi   previous kernel (choose it in the firmware's boot menu)
# Installs from before 2026-10-07 also had /boot/EFI/cig/vmlinuz.efi with a boot entry
# pointing there: if it exists it is kept up to date.
set -e
M=/usr/lib/modules
kver=${1:-$(ls -t "$M"/*/vmlinuz 2>/dev/null | head -n1 | cut -d/ -f5)}
[ -n "$kver" ] && [ -f "$M/$kver/vmlinuz" ] || { echo "cig-kernel-install: no kernel found" >&2; exit 1; }

depmod "$kver" 2>/dev/null || true

mounted=0
if ! mountpoint -q /boot; then
    if mount /boot 2>/dev/null; then mounted=1
    else echo "cig-kernel-install: EFI partition not mounted at /boot; kernel $kver NOT deployed" >&2; exit 1
    fi
fi
K=/boot/EFI/BOOT/BOOTX64.EFI
mkdir -p /boot/EFI/BOOT /boot/EFI/cig
# the previous kernel becomes the fallback - unless it is the very same kernel
if [ -f "$K" ] && ! cmp -s "$M/$kver/vmlinuz" "$K"; then
    cp "$K" /boot/EFI/cig/vmlinuz-old.efi
fi
cp "$M/$kver/vmlinuz" "$K.new" && mv "$K.new" "$K"
[ ! -f /boot/EFI/cig/vmlinuz.efi ] || cp "$M/$kver/vmlinuz" /boot/EFI/cig/vmlinuz.efi
sync
[ "$mounted" = 1 ] && umount /boot
echo "cig-kernel-install: $kver deployed to the EFI partition ($K)"
