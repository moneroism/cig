# The install medium's kernel only (CIG_KERNEL_INITRAMFS set): a built-in initramfs finds
# the ISO by its volume label and starts the live system from it (CD/DVD and USB stick)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SR=y
