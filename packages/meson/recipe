# meson - build system (installed as a plain Python package, no pip)
name=meson
version=1.12.1
source="https://github.com/mesonbuild/meson/releases/download/$version/meson-$version.tar.gz"
signature="https://github.com/mesonbuild/meson/releases/download/$version/meson-$version.tar.gz.asc"
keys="19E2D6D9B46D8DAA6288F877C24E631BABB1FE70"
sha256="-"
depends="python samurai"
style=custom
do_build() { :; }
do_install() {
    local site
    site=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    mkdir -p "$DEST$site" "$DEST/usr/bin"
    cp -a mesonbuild "$DEST$site/"
    printf '#!/usr/bin/python3\nimport sys\nfrom mesonbuild.mesonmain import main\nsys.exit(main())\n' \
        > "$DEST/usr/bin/meson"
    chmod 755 "$DEST/usr/bin/meson"
}
