meson_args="-Dtests=disabled -Ddocs=disabled -Dintrospection=disabled -Dfreetype=enabled -Dglib=enabled
    -Dgobject=disabled -Dcairo=disabled -Dicu=disabled -Dutilities=disabled -Dbenchmark=disabled
