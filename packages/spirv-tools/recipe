# spirv-tools - SPIR-V optimizer, validator and assembler (a build tool: mesa-clc links it)
# Unsigned upstream (lightweight tags, no release files). v2026.4 is the same commit as the
# Vulkan SDK tag vulkan-sdk-1.4.363.0 that spirv-headers uses (the SDK pairs them). The tarball's
# SHA256 is the one in Void's template, checked 2026-11-26.
name=spirv-tools
version=2026.4
license="Apache-2.0"
source="spirv-tools-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-Tools/archive/refs/tags/v$version.tar.gz"
sha256="92df4c377603f086c3d2a1eb2bd9b8f883a73ca890fb939d78a0cecdcc01686c"
depends="gcc"
makedepends="cmake samurai python spirv-headers"
style=custom
wrksrc="SPIRV-Tools-$version"
do_build() {
    cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DSPIRV-Headers_SOURCE_DIR=/usr -DSPIRV_WERROR=OFF \
        -DSPIRV_SKIP_TESTS=ON -DSPIRV_TOOLS_BUILD_STATIC=OFF -DBUILD_SHARED_LIBS=ON
    samu -C build
}
do_install() { DESTDIR="$DEST" samu -C build install; }
