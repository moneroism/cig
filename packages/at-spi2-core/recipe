# at-spi2-core - accessibility: ATK, its bridge and the AT-SPI bus, through which screen readers
# reach programs (Chromium's accessibility). No X11. Talks over D-Bus. GNOME does not sign
# tarballs (flagged in docs/sources.md).
name=at-spi2-core
version=2.62.2
license="LGPL-2.1-or-later"
source="https://download.gnome.org/sources/at-spi2-core/${version%.*}/at-spi2-core-$version.tar.xz"
sha256="7ce81820ddf873b8d930177e0790f730f60d22d8e0acee9ba8f75d8202598de3"
depends="dbus glib libxml2"
makedepends="meson pkgconf"
style=meson
meson_args="-Dx11=disabled -Dintrospection=disabled -Ddocs=false -Ddbus_daemon=/usr/bin/dbus-daemon
    -Duse_systemd=false"
