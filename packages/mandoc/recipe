# mandoc - manual pages (man)
name=mandoc
version=1.14.6
source="https://mandoc.bsd.lv/snapshots/mandoc-$version.tar.gz"
sha256="8bf0d570f01e70a6e124884088870cbed7537f36328d512909eb10cd53179d9c"
depends="zlib"
style=custom
group="tools"
do_build() {
    printf 'PREFIX=/usr\nMANDIR=/usr/share/man\nCC=cc\n' > configure.local
    ./configure
    make
}
do_install() { make DESTDIR="$DEST" install; }
