#!/bin/sh
# udhcpc event script.
# DNS: if /etc/resolv.conf.static exists it is used instead of the
# DHCP-provided servers (for your own resolver / encrypted DNS).
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface"
        ip link set "$interface" up ;;
    bound|renew)
        ip -4 addr flush dev "$interface"
        ip -4 addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
        if [ -n "$router" ]; then
            while ip -4 route del default dev "$interface" 2>/dev/null; do :; done
            set -- $router
            ip -4 route add default via "$1" dev "$interface"
        fi
        if [ -f /etc/resolv.conf.static ]; then
            cp /etc/resolv.conf.static /etc/resolv.conf
        else
            {
                [ -n "$domain" ] && echo "search $domain"
                for d in $dns; do echo "nameserver $d"; done
            } > /etc/resolv.conf.tmp && mv /etc/resolv.conf.tmp /etc/resolv.conf
        fi ;;
esac
exit 0
