#!/bin/sh
# rc.init - system startup, started by sinit (PID 1)
PATH=/usr/bin:/usr/sbin
umask 022

mountpoint -q /proc || mount -t proc     -o nosuid,nodev,noexec proc /proc
mountpoint -q /sys  || mount -t sysfs    -o nosuid,nodev,noexec sysfs /sys
mountpoint -q /dev  || mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts -o nosuid,noexec,gid=5,mode=0620 devpts /dev/pts
mount -t tmpfs  -o nosuid,nodev,noexec,mode=1777 tmpfs /dev/shm
mount -t tmpfs  -o nosuid,nodev,mode=0755 tmpfs /run

# /dev/fd and the std streams: bash process substitution <(...) needs /dev/fd
ln -sfn /proc/self/fd /dev/fd
ln -sfn /proc/self/fd/0 /dev/stdin
ln -sfn /proc/self/fd/1 /dev/stdout
ln -sfn /proc/self/fd/2 /dev/stderr

if [ -f /etc/cig/live ]; then
    # live system (install media, cig-live): the medium stays read-only; what changes
    # lives in RAM. /var/cig (sources and packages, the installer's mirror) stays on
    # the medium and is never copied.
    mkdir -p /run/live
    mount -t tmpfs -o mode=0755 tmpfs /run/live
    for d in etc var home root mnt; do
        mkdir -p "/run/live/$d"
        for e in "/$d"/* "/$d"/.[!.]*; do
            [ -e "$e" ] || [ -L "$e" ] || continue
            [ "$e" = /var/cig ] && continue
            cp -a "$e" "/run/live/$d/"
        done
        chmod "$(stat -c %a "/$d")" "/run/live/$d"
    done
    mkdir -p /run/live/var/cig
    mount --bind /var/cig /run/live/var/cig
    for d in etc var home root mnt; do mount --rbind "/run/live/$d" "/$d"; done
else
    mount -o remount,rw /
fi
mount -a
swapon -a 2>/dev/null

[ -s /etc/hostname ] && hostname -F /etc/hostname
hwclock -s -u 2>/dev/null
# the clock never starts earlier than the last time this system ran (rc.shutdown) or was
# installed or built (the inventory): a flat clock battery or a firmware reset sets it back
# years, and TLS, DNSSEC and signature checks then fail. The installer asks for the real time.
last=$(stat -c %Y /var/lib/cig/clock /usr/pkg/INVENTORY 2>/dev/null | sort -n | tail -n 1)
if [ -n "$last" ] && [ "$(date +%s)" -lt "$last" ]; then
    date -u -s "@$last" >/dev/null && hwclock -w -u 2>/dev/null
    mkdir -p /run/cig && echo "$last" > /run/cig/clock-was-behind
fi
ip link set lo up
[ -f /etc/sysctl.conf ] && sysctl -q -p /etc/sysctl.conf
for f in /etc/sysctl.d/*.conf; do [ -f "$f" ] && sysctl -q -p "$f"; done

# hardware: hotplug daemon, then drivers for devices already present
mdev -d
for m in $(find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u); do
    modprobe -q "$m" 2>/dev/null
done
mdev -s

# sound: the saved mixer state, or ALSA's unmuted defaults the first time
command -v alsactl >/dev/null && alsactl restore 2>/dev/null

# optional: no further kernel modules until reboot
[ -f /etc/lock-modules ] && echo 1 > /proc/sys/kernel/modules_disabled

# per-user runtime directories (normally logind's job)
mkdir -p -m 0755 /run/user
awk -F: '$3 >= 1000 && $3 < 65534 {print $3, $4}' /etc/passwd | while read -r u g; do
    install -d -m 700 -o "$u" -g "$g" "/run/user/$u"
done

# local additions
[ -x /etc/rc.local ] && /etc/rc.local

# services: supervised by runsvdir
runsvdir -P /etc/service &
