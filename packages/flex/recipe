# flex - lexer generator (build tool). Pre-C23 code: built as C17.
name=flex
version=2.6.4
source="https://github.com/westes/flex/releases/download/v$version/flex-$version.tar.gz"
signature="https://github.com/westes/flex/releases/download/v$version/flex-$version.tar.gz.sig"
sha256="e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995"
style=custom
do_build() {
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --disable-static --disable-nls
    make MAKEINFO=true HELP2MAN=true
}
do_install() {
    make MAKEINFO=true HELP2MAN=true DESTDIR="$DEST" install
    ln -sf flex "$DEST/usr/bin/lex"
}
