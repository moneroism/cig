# cig-tools - cig's own tools on every system: cigbuild, smoke and the recipes.
# (The installer is its own package, cig-installer, for the install media only.)
# Built from this repository (no download); version = the cig release.
# smoke is C (src/smoke), compiled in the build folder, never inside the repository.
name=cig-tools
version=$(cat "$CIG_REPO/VERSION")
rel=3
makedepends="make"
source=""
sha256=""
style=custom
group="base"
nostrip=1
do_build() {
    rm -rf "$WORK/smoke"
    cp -R "$CIG_REPO/src/smoke" "$WORK/smoke"
    make -C "$WORK/smoke" clean    # copied from the checkout: drop any host build first
    make -C "$WORK/smoke" smoke
}
do_install() {
    local s="$DEST/usr/share/cig"
    mkdir -p "$s" "$DEST/usr/bin"
    cp "$CIG_REPO/VERSION" "$s/"
    cp "$CIG_REPO/cigbuild" "$s/"
    install -m 755 "$WORK/smoke/smoke" "$s/smoke"
    cp -R "$CIG_REPO/lib" "$CIG_REPO/packages" "$CIG_REPO/src" "$s/"   # src: recipes built from it
    chmod -R u+rwX,go+rX,go-w "$s"          # readable for all, keep execute bits
    chmod 755 "$s/cigbuild" "$s/smoke"
    ln -s ../share/cig/cigbuild "$DEST/usr/bin/cigbuild"
    ln -s ../share/cig/smoke "$DEST/usr/bin/smoke"
}
