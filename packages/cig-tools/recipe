# cig-tools - cig's own tools on every system: cigbuild, smoke and the recipes.
# (The installer is its own package, cig-installer, for the install media only.)
# Built from this repository (no download); version = the cig release.
# smoke is C (src/smoke), compiled in the build folder, never inside the repository.
name=cig-tools
version=$(cat "$CIG_REPO/VERSION")
rel=14
makedepends="make"
license="GPL-3.0-or-later"
source=""
sha256=""
style=custom
group="base"
nostrip=1
do_build() {
    rm -rf "$WORK/src"
    mkdir -p "$WORK/src"   # with src/libre, the libre-meter it shares with the installer
    cp -R "$CIG_REPO/src/smoke" "$CIG_REPO/src/libre" "$WORK/src/"
    make -C "$WORK/src/smoke" clean    # copied from the checkout: drop any host build first
    make -C "$WORK/src/smoke" smoke
}
do_install() {
    local s="$DEST/usr/share/cig"
    mkdir -p "$s" "$DEST/usr/bin"
    cp "$CIG_REPO/VERSION" "$s/"
    cp "$CIG_REPO/cigbuild" "$s/"
    install -m 755 "$WORK/src/smoke/smoke" "$s/smoke"
    cp "$CIG_REPO/names" "$s/"
    cp -R "$CIG_REPO/lib" "$CIG_REPO/packages" "$CIG_REPO/keys" "$CIG_REPO/src" "$CIG_REPO/assets" "$CIG_REPO/libre" "$s/"   # keys: gpgv checks sources against them; src, assets: used by recipes; libre: the libre-meter's data
    local d   # sources only: a build left in the checkout (on the host: glibc) must not ship
    for d in "$s"/src/*/; do [ ! -f "$d/Makefile" ] || make -C "$d" clean >/dev/null; done
    chmod -R u+rwX,go+rX,go-w "$s"          # readable for all, keep execute bits
    chmod 755 "$s/cigbuild" "$s/smoke"
    ln -s ../share/cig/cigbuild "$DEST/usr/bin/cigbuild"
    ln -s ../share/cig/smoke "$DEST/usr/bin/smoke"
}
