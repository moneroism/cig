# wpa_supplicant - WiFi (WPA2/WPA3-Personal only: no WPS, no D-Bus, no EAP)
name=wpa_supplicant
version=2.12
source="https://w1.fi/releases/wpa_supplicant-$version.tar.gz"
signature="https://w1.fi/releases/wpa_supplicant-$version.tar.gz.asc"
sha256="08e23937e16d0155e55cab2b51f51fbe10d80a1aa91c4e15442645059b737ef6"
depends="libnl openssl"
style=custom
do_build() {
    cd wpa_supplicant
    cat > .config <<'CFG'
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
LIBNL_INC=/usr/include/libnl3
CONFIG_TLS=openssl
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_SAE=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CFG
    make BINDIR=/usr/sbin LIBDIR=/usr/lib
}
do_install() {
    cd wpa_supplicant
    for b in wpa_supplicant wpa_cli wpa_passphrase; do
        install -D -m 755 "$b" "$DEST/usr/sbin/$b"
    done
}
group="network"
default=on
