# mesa - GPU drivers without LLVM: Vulkan for AMD (RADV, with its own ACO compiler) and OpenGL/GLES
# through Vulkan (Zink); EGL and GBM for Wayland compositors. (no software renderer: without a GPU driver, wlroots uses pixman)
name=mesa
version=26.2.4
rel=4
source="https://archive.mesa3d.org/mesa-$version.tar.xz"
signature="https://archive.mesa3d.org/mesa-$version.tar.xz.sig"
keys="57551DE15B968F6341C248F68D8E31AFC32428A6"
sha256="-"
depends="libdrm expat zlib wayland libudev-zero elfutils vulkan-loader libdisplay-info"
makedepends="meson pkgconf python-mako python-packaging python-pyyaml wayland-protocols bison flex glslang"
style=meson
group="graphics"
# Wayland only, no LLVM, no X11; only what the drivers above need
meson_args="-Dplatforms=wayland -Dgallium-drivers=zink -Dvulkan-drivers=amd -Dllvm=disabled
    -Dglx=disabled -Degl=enabled -Dgbm=enabled -Dgles1=disabled -Dgles2=enabled -Dopengl=true
    -Dvalgrind=disabled -Dlibunwind=disabled -Dzstd=disabled -Dlmsensors=disabled
    -Dvideo-codecs= -Dvulkan-layers= -Dtools= -Dbuild-tests=false -Dmicrosoft-clc=disabled
    -Dandroid-libbacktrace=disabled -Dgallium-va=disabled
    -Dgallium-extra-hud=false -Dvulkan-beta=false"

# the C++ runtime (libstdc++, libgcc_s) belongs to gcc, which installed systems do not have:
# link it in statically (this build only: pre_build runs in the package's build process)
pre_build() { export LDFLAGS="$LDFLAGS -static-libgcc -static-libstdc++"; }
