# mesa - GPU drivers without LLVM: Vulkan for AMD (RADV, with its own ACO compiler) and OpenGL/GLES
# through Vulkan (Zink); EGL and GBM for Wayland compositors. softpipe is the software fallback.
name=mesa
version=26.2.4
source="https://archive.mesa3d.org/mesa-$version.tar.xz"
signature="https://archive.mesa3d.org/mesa-$version.tar.xz.sig"
sha256="bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9"
depends="libdrm expat zlib wayland libudev-zero elfutils vulkan-loader"
makedepends="meson pkgconf python-mako python-packaging python-pyyaml wayland-protocols bison flex glslang"
style=meson
group="desktop"
# Wayland only, no LLVM, no X11; only what the drivers above need
meson_args="-Dplatforms=wayland -Dgallium-drivers=zink,softpipe -Dvulkan-drivers=amd -Dllvm=disabled
    -Dglx=disabled -Degl=enabled -Dgbm=enabled -Dgles1=disabled -Dgles2=enabled -Dopengl=true
    -Dvalgrind=disabled -Dlibunwind=disabled -Dzstd=disabled -Dlmsensors=disabled
    -Dvideo-codecs= -Dvulkan-layers= -Dtools= -Dbuild-tests=false -Dmicrosoft-clc=disabled
    -Dandroid-libbacktrace=disabled -Dgallium-va=disabled -Dgallium-vdpau=disabled
    -Dgallium-extra-hud=false -Dvulkan-beta=false"
