# busybox - core userland in one binary. Trimmed config: files/busybox.config
# (no network servers, no su, no setuid, no BusyBox TLS).
name=busybox
version=1.38.0
rel=2
source="https://busybox.net/downloads/busybox-$version.tar.bz2"
signature="https://busybox.net/downloads/busybox-$version.tar.bz2.sig"
keys="C9E9416F76E610DBD09D040F47B70C55ACC9965B"
sha256="-"
style=custom
do_build() {
    cp "$PKGDIR/files/busybox.config" .config
    # options a new busybox version adds get upstream's default; they are listed in the
    # build log (grep NEW) to be reviewed and then written into files/busybox.config
    make oldconfig < <(yes "") > oldconfig.log
    grep '(NEW)' oldconfig.log || true
    make
}
do_install() {
    install -D -m 755 busybox "$DEST/usr/bin/busybox"
}
# applet links are created on the target, only where no real program exists
post_install() {
    local p
    /usr/bin/busybox --list-full | while read -r p; do
        p="/${p#/}"
        [ -e "$p" ] || [ -L "$p" ] || /usr/bin/busybox ln -s /usr/bin/busybox "$p"
    done
}
group="base"
