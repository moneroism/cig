# make - GNU make. Pre-C23 code: built as C17.
name=make
version=4.4.1
source="https://ftp.gnu.org/gnu/make/make-$version.tar.gz"
signature="https://ftp.gnu.org/gnu/make/make-$version.tar.gz.sig"
keys="6D4EEB02AD834703510B117680CB727A20C79BB2"
sha256="-"
style=custom
do_build() {
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --without-guile --disable-nls
    make
}
do_install() { make DESTDIR="$DEST" install; }
