# spirv-llvm-translator - LLVM IR to SPIR-V and back (a build tool: mesa-clc links it). Its
# version follows LLVM's: 23.1.x for llvm 23.1 (Mesa refuses any other pairing)
# Unsigned upstream (lightweight tags, no release files). The tarball's SHA512 and size are the ones
# in Gentoo's Manifest, checked 2026-11-26.
# It builds against the SPIRV-Headers commit named in its spirv-headers-tag.conf (newer than any
# Headers release: 23.1.3 needs SPV_INTEL_subgroup_bitcast_shuffle), a second source here, as
# Arch and Gentoo do (its tarball: size and BLAKE2B as in Gentoo's Manifest, checked 2026-11-26).
name=spirv-llvm-translator
version=23.1.3
_headers=cb42dec3830d3ac67fa449ecdc0c0f73d5e74498
license="NCSA"
source="spirv-llvm-translator-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/refs/tags/v$version.tar.gz
    spirv-headers-$_headers.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_headers.tar.gz"
sha256="9ed57de3f31c575c836bef8f05ce5dfa98a8d80e64d948a02aac83c2e124f842 117010e525fe36b1ce006e0e58a6e0a3b415aabc9179d912b92737f41f3f994f"
depends="llvm spirv-tools gcc"
makedepends="cmake samurai"
style=custom
wrksrc="SPIRV-LLVM-Translator-$version"
track=23.1
# LLVM's CMake files list its static libraries, which the llvm package does not have (cigbuild
# drops *.a), and CMake stops at the first missing one. This build reads a copy that points at
# /usr and only notes them (cmake --log-level=VERBOSE): the translator links libLLVM.so
# (LLVM_LINK_LLVM_DYLIB=ON). Tested on the host: find_package(LLVM) loads, prefix /usr.
# (The lasting fix: llvm exports only what it installs, LLVM_DISTRIBUTION_COMPONENTS.)
pre_build() {
    local c="$WORK/llvm-cmake"
    mkdir -p "$c"
    cp /usr/lib/cmake/llvm/*.cmake "$c/"
    sed -i -e 's|^get_filename_component(LLVM_INSTALL_PREFIX "${CMAKE_CURRENT_LIST_FILE}" REALPATH)$|set(LLVM_INSTALL_PREFIX "/usr/lib/cmake/llvm/LLVMConfig.cmake")|' \
        -e "s|^set(LLVM_CMAKE_DIR .*|set(LLVM_CMAKE_DIR \"$c\")|" "$c/LLVMConfig.cmake"
    sed -i -e 's|^get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)$|set(_IMPORT_PREFIX "/usr/lib/cmake/llvm")|' \
        -e 's|message(FATAL_ERROR "The imported target|message(VERBOSE "not packaged (static): the imported target|' "$c/LLVMExports.cmake"
    grep -q '^set(LLVM_INSTALL_PREFIX "/usr' "$c/LLVMConfig.cmake" && grep -q "^set(LLVM_CMAKE_DIR \"$c\")" "$c/LLVMConfig.cmake" \
        && grep -q '^set(_IMPORT_PREFIX "/usr/lib/cmake/llvm")' "$c/LLVMExports.cmake" \
        || die "LLVM's CMake files changed: the copy for this build needs updating"
}
do_build() {
    cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_DIR="$WORK/llvm-cmake" \
        -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR="$WORK/src/SPIRV-Headers-$_headers" \
        -DCMAKE_SKIP_INSTALL_RPATH=ON
    samu -C build
}
do_install() { DESTDIR="$DEST" samu -C build install; }
