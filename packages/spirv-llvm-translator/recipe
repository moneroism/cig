# spirv-llvm-translator - LLVM IR to SPIR-V and back (a build tool: mesa-clc links it). Its
# version follows LLVM's: 23.1.x for llvm 23.1 (Mesa refuses any other pairing)
# Unsigned upstream (lightweight tags, no release files). The tarball's SHA512 and size are the ones
# in Gentoo's Manifest, checked 2026-11-26.
name=spirv-llvm-translator
version=23.1.3
license="NCSA"
source="spirv-llvm-translator-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/refs/tags/v$version.tar.gz"
sha256="9ed57de3f31c575c836bef8f05ce5dfa98a8d80e64d948a02aac83c2e124f842"
depends="llvm spirv-tools gcc"
makedepends="cmake samurai spirv-headers"
style=custom
wrksrc="SPIRV-LLVM-Translator-$version"
track=23.1
do_build() {
    cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON
    samu -C build
}
do_install() { DESTDIR="$DEST" samu -C build install; }
