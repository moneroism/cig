# pixel - terminal animations: plasma, tunnel, fractal zoom, stars (ASCII for the console, -u for 256 colours)
# Part of cig (src/pixel): built from the repository, like cig-tools.
name=pixel
version=$(cat "$CIG_REPO/VERSION")
source=""
sha256=""
makedepends="make"
style=custom
group="tools"
do_build() {
    rm -rf "$WORK/pixel"
    cp -R "$CIG_REPO/src/pixel" "$WORK/pixel"
    make -C "$WORK/pixel" clean    # copied from the checkout: drop any host build first
    make -C "$WORK/pixel" pixel
}
do_install() { install -D -m 755 "$WORK/pixel/pixel" "$DEST/usr/bin/pixel"; }
