# cig-installer - cig-install, the installer. Only for the install media (and the dev
# system): no group=, so the installer never offers it and installed systems never get it.
# The installer is C with ncurses (src/installer), compiled in the build folder.
# Until the C installer has passed its VM tests, the shell version stays as cig-install-sh.
name=cig-installer
version=$(cat "$CIG_REPO/VERSION")
rel=2
source=""
sha256=""
depends="cig-tools util-linux e2fsprogs ncurses"
makedepends="make ncurses"
style=custom
do_build() {
    [ -f "$CIG_REPO/src/installer/main.c" ] \
        || { echo "cig-installer is built from the cig repository (with src/installer), not from an installed system"; exit 1; }
    rm -rf "$WORK/installer"
    cp -R "$CIG_REPO/src/installer" "$WORK/installer"
    make -C "$WORK/installer" clean cig-install
}
do_install() {
    local s="$DEST/usr/share/cig/installer"
    mkdir -p "$s" "$DEST/usr/bin"
    install -m 755 "$WORK/installer/cig-install" "$s/cig-install"
    install -m 755 "$CIG_REPO/installer/cig-install" "$s/cig-install-sh"
    ln -s ../share/cig/installer/cig-install "$DEST/usr/bin/cig-install"
    ln -s ../share/cig/installer/cig-install-sh "$DEST/usr/bin/cig-install-sh"
}
