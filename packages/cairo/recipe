# cairo - 2D graphics (no X11)
name=cairo
version=1.18.6
source="https://cairographics.org/releases/cairo-$version.tar.xz"
signature="tag=https://gitlab.freedesktop.org/cairo/cairo.git#$version"
sha256="1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4"
depends="pixman freetype fontconfig libpng zlib glib"
makedepends="meson pkgconf"
style=meson
meson_args="-Dxlib=disabled -Dxcb=disabled -Dtests=disabled -Dgtk_doc=false -Dspectre=disabled
    -Dsymbol-lookup=disabled -Dglib=enabled -Dpng=enabled -Dfreetype=enabled -Dfontconfig=enabled
    -Dzlib=enabled"
