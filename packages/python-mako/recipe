# python-mako - templates (needed to build Mesa) (Python module, a build tool: installed as plain files, no pip)
name=python-mako
version=1.4.3
source="https://files.pythonhosted.org/packages/5a/09/e07c4b5579a79f4b16f8d4f29f6c54514ac787c4ad506b8c4f28a0e6b0bf/mako-$version.tar.gz"
sha256="cd6537fe88d5fec315c55c2f8529bc4ce7a9a352ad7db3eeaa6a66e2dd4ec37a"
depends="python python-markupsafe"
style=custom
do_build() { :; }
do_install() {
    local site
    site=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
    mkdir -p "$DEST$site"
    cp -a mako "$DEST$site/"
    find "$DEST$site" \( -name '*.c' -o -name '*.pyi' -o -name __pycache__ \) -prune -exec rm -rf {} +
}
