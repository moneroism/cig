# glslang - GLSL/HLSL shader compiler (a build tool: Mesa compiles RADV's shaders with it)
name=glslang
version=16.6.0
source="glslang-$version.tar.gz::https://github.com/KhronosGroup/glslang/archive/refs/tags/$version.tar.gz"
sha256="9c09b901149c729df745057dafa815278aaa101b84d2b6e14f16a42de52f97f2"
makedepends="cmake make python"
style=custom
# no SPIRV-Tools optimizer, no tests: the validator binary is what Mesa needs
do_build() {
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_OPT=OFF -DGLSLANG_TESTS=OFF -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=OFF \
        -DENABLE_GLSLANG_BINARIES=ON
    make -C build
}
do_install() { make -C build DESTDIR="$DEST" install; }
