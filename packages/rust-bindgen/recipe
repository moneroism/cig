do_build() {
    local n v c
    tar -C "$WORK" -xzf "$CIG_VAR/sources/rust-bindgen-$version.tar.gz"
    cd "$WORK/rust-bindgen-$version"
    # the pinned crates as a vendored source, each named with its Cargo.lock checksum
    mkdir -p "$WORK/vendor"
    awk '/^\[\[package\]\]/{n="";v=""} /^name = /{gsub(/"/,"",$3);n=$3} /^version = /{gsub(/"/,"",$3);v=$3}
         /^checksum = /{gsub(/"/,"",$3); print n, v, $3}' Cargo.lock |
    while read -r n v c; do
        tar -C "$WORK/vendor" -xzf "$CIG_VAR/sources/$n-$v.crate"
        printf '{"files":{},"package":"%s"}' "$c" > "$WORK/vendor/$n-$v/.cargo-checksum.json"
    done
    mkdir -p .cargo
    printf '%s\n' '[source.crates-io]' 'replace-with = "vendored"' '[source.vendored]' \
        "directory = \"$WORK/vendor\"" > .cargo/config.toml
    # dynamically linked: it dlopens libclang, which a static musl binary cannot
    RUSTFLAGS="-Ctarget-feature=-crt-static" CARGO_HOME="$WORK/cargo" LIBCLANG_PATH=/usr/lib cargo build --release --offline --locked -p bindgen-cli
}
do_install() {
    install -D -m 755 "$WORK/rust-bindgen-$version/target/release/bindgen" "$DEST/usr/bin/bindgen"
    printf 'int cig_probe(int);\n' > "$WORK/probe.h"
    "$DEST/usr/bin/bindgen" "$WORK/probe.h" | grep -q 'pub fn cig_probe'
}
