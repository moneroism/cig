# libdrm - kernel graphics interface.
# Core always; GPU vendor helpers only for the GPUs this build targets
# (see lib/hardware.sh: detected, chosen in the installer, or "generic").
name=libdrm
version=2.4.134
source="https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz"
signature="https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz.sig"
keys="34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48"
sha256="-"
makedepends="meson pkgconf"
style=meson
meson_args="-Damdgpu=$(gpu_feature amd) -Dradeon=$(gpu_feature amd)
    -Dintel=$(gpu_feature intel) -Dnouveau=$(gpu_feature nvidia) -Dvmwgfx=$(gpu_feature vmware)
    -Dfreedreno=disabled -Dvc4=disabled -Detnaviv=disabled
    -Dexynos=disabled -Domap=disabled -Dtegra=disabled
    -Dvalgrind=disabled -Dcairo-tests=disabled -Dman-pages=disabled -Dtests=false -Dudev=false"
