# linux-firmware - device firmware. Never CPU microcode.
#
# Only what this machine needs is unpacked and installed:
#   CIG_FIRMWARE=all             everything (install media), zstd-compressed (the kernel reads
#                                .zst firmware: FW_LOADER_COMPRESS_ZSTD)
#   CIG_FIRMWARE_LIST=<file>     explicit list, one path per line (the installer)
#   CIG_FIRMWARE_TREE=<folder>   with a list: the files from that firmware tree instead of the
#                                archive (the installer on the install medium: the live system's,
#                                all of this recipe's verified archive); nothing is downloaded
#   /etc/cig/firmware.list       explicit list on an installed system
#   otherwise                    detect: firmware requested by the drivers in use now
# What got installed is listed in /usr/share/cig/firmware.list, and each file's licence (from
# WHENCE: free or non-free, for the libre-meter) in /usr/share/cig/firmware.licenses
name=linux-firmware
version=20261124
# license: per file, listed in WHENCE; many files are not free (redistributable only)
license="LicenseRef-linux-firmware"
source="https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-$version.tar.xz"
signature="https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-$version.tar.sign"
keys="4CDE8575E547BF835FE15807A31B6BD72486CFD6"
sha256="2cabe10253005f55bf4bbc0ebb25c0964d66f7c4121ffa47853ff1e70ea1aa54"
style=custom
nostrip=1
noextract=1          # the archive is large; unpack only the selected files
if [ -n "${CIG_FIRMWARE_TREE:-}" ]; then source="" signature="" sha256="" keys=""; fi

_tarball() { echo "$CIG_VAR/sources/linux-firmware-$version.tar.xz"; }
_top="linux-firmware-$version"

_detect() {
    # firmware= entries of the cig kernel's modules for every driver loaded now
    local kdir m f
    # no module tree (a chroot, a kernel without modules): nothing to detect; under pipefail a
    # failing ls would end the build
    kdir=$(ls -dt /usr/lib/modules/*/ 2>/dev/null | head -n1 || true)
    [ -n "$kdir" ] || return 0
    lsmod | awk 'NR > 1 { print $1 }' | while read -r m; do
        f=$(find "$kdir" \( -name "$m.ko" -o -name "$(echo "$m" | tr _ -).ko" \) | head -n1)
        if [ -n "$f" ]; then { strings "$f" 2>/dev/null || true; } | sed -n 's/^firmware=//p'; fi
    done | sort -u
}

# libre/alternatives: a non-free file whose free replacement the same driver loads instead
# (ath9k_htc tries its open 1.4.0 firmware first) is never installed: the free one is
_free_instead() {
    awk 'NR == FNR { if ($1 == "firmware") alt[$2] = $3; next }
         { print ($0 in alt) ? alt[$0] : $0 }' "$CIG_REPO/libre/alternatives" -
}

_wanted() {
    if [ -n "${CIG_FIRMWARE_LIST:-}" ]; then
        { grep -v '^#' "$CIG_FIRMWARE_LIST" || true; }
    elif [ -f /etc/cig/firmware.list ]; then
        { grep -v '^#' /etc/cig/firmware.list || true; }
    else
        _detect
    fi | sed '/^$/d' | { grep -v -E '^(intel-ucode|amd-ucode)/' || true; } | _free_instead | sort -u
}

do_build() {
    mkdir -p "$WORK/out"
    if [ "${CIG_FIRMWARE:-}" = all ]; then
        tar -C "$WORK" -xf "$(_tarball)"
        ( cd "$WORK/$_top" && { sh copy-firmware.sh --zstd --ignore-duplicates "$WORK/out" 2>/dev/null \
                                || sh copy-firmware.sh --zstd "$WORK/out"; } )
        rm -rf "$WORK/out/intel-ucode" "$WORK/out/amd-ucode"
        # nor the non-free files that have a free replacement (libre/alternatives)
        awk '$1 == "firmware" { print $2 }' "$CIG_REPO/libre/alternatives" | while read -r f; do
            rm -f "$WORK/out/$f" "$WORK/out/$f.zst"
        done
        return
    fi

    _wanted > "$WORK/wanted"
    if [ ! -s "$WORK/wanted" ]; then echo "no firmware selected"; return; fi
    echo "firmware requested: $(wc -l < "$WORK/wanted") file(s)"

    if [ -n "${CIG_FIRMWARE_TREE:-}" ]; then   # plain files, as from the archive
        while read -r f; do
            # only the tree's linux-firmware files (its firmware.list): other packages put
            # files there too, and one copied here would belong to two packages (laptop test
            # 2026-11-27: cfg80211's regulatory.db, from wireless-regdb; smoke then refused
            # wireless-regdb, and wpa_supplicant, which needs it, was not installed)
            if [ -f /usr/share/cig/firmware.list ] && ! grep -qxF "$f" /usr/share/cig/firmware.list; then
                echo "not in linux-firmware $version: $f"
            elif [ -f "$CIG_FIRMWARE_TREE/$f" ]; then
                install -D -m 644 "$CIG_FIRMWARE_TREE/$f" "$WORK/out/$f"
            elif [ -f "$CIG_FIRMWARE_TREE/$f.zst" ]; then
                mkdir -p "$(dirname "$WORK/out/$f")"
                # through stdin: the live system's files are farm links, and zstd skips a
                # link named as an argument ("is a symbolic link, ignoring": exit status 1)
                zstd -dqc < "$CIG_FIRMWARE_TREE/$f.zst" > "$WORK/out/$f"
                chmod 644 "$WORK/out/$f"
            else
                echo "not in the firmware tree $CIG_FIRMWARE_TREE: $f"
            fi
        done < "$WORK/wanted"
        return
    fi

    # pass 1: the requested names plus WHENCE (which defines links between names)
    tar -C "$WORK" -xf "$(_tarball)" "$_top/WHENCE" \
        $(sed "s#^#$_top/#" "$WORK/wanted") 2>/dev/null || true
    # names that are links in WHENCE ("Link: a -> b", b relative to a's folder)
    : > "$WORK/links"
    while read -r f; do
        [ -e "$WORK/$_top/$f" ] && continue
        t=$(sed -n "s#^Link: $f -> ##p" "$WORK/$_top/WHENCE" | head -n1)
        [ -n "$t" ] || continue
        case "$f" in */*) t="${f%/*}/$t" ;; esac
        echo "$f $t" >> "$WORK/links"
    done < "$WORK/wanted"
    # pass 2: the link targets, if any
    if [ -s "$WORK/links" ]; then
        tar -C "$WORK" -xf "$(_tarball)" $(awk -v p="$_top/" '{ print p $2 }' "$WORK/links") 2>/dev/null || true
    fi

    while read -r f; do
        if [ -f "$WORK/$_top/$f" ]; then
            install -D -m 644 "$WORK/$_top/$f" "$WORK/out/$f"
        else
            t=$(awk -v f="$f" '$1 == f { print $2 }' "$WORK/links")
            if [ -n "$t" ] && [ -f "$WORK/$_top/$t" ]; then
                install -D -m 644 "$WORK/$_top/$t" "$WORK/out/$f"
            else
                echo "not in linux-firmware $version: $f"
            fi
        fi
    done < "$WORK/wanted"
}

do_install() {
    mkdir -p "$DEST/usr/lib/firmware" "$DEST/usr/share/cig"
    cp -R "$WORK/out/." "$DEST/usr/lib/firmware/"
    # names without .zst (the kernel finds the compressed file by the plain name)
    ( cd "$DEST/usr/lib/firmware" && find . -type f | sed 's#^\./##; s#\.zst$##' | sort ) > "$DEST/usr/share/cig/firmware.list"
    echo "firmware files installed: $(wc -l < "$DEST/usr/share/cig/firmware.list")"
    # the licence of each installed file (libre-meter): WHENCE, and libre/firmware for free
    # firmware whose source is kept outside linux-firmware
    : > "$DEST/usr/share/cig/firmware.licenses"
    if [ -s "$DEST/usr/share/cig/firmware.list" ] && [ -n "${CIG_FIRMWARE_TREE:-}" ]; then
        # the tree's own licence list (made from WHENCE when the tree was built)
        awk -F'\t' 'NR == FNR { want[$0] = 1; next } $1 in want' "$DEST/usr/share/cig/firmware.list" \
            /usr/share/cig/firmware.licenses | sort > "$DEST/usr/share/cig/firmware.licenses"
        echo "free firmware files: $(awk -F'\t' '$2 == "free"' "$DEST/usr/share/cig/firmware.licenses" | wc -l)"
    elif [ -s "$DEST/usr/share/cig/firmware.list" ]; then
        awk -f "$PKGDIR/files/whence-index.awk" "$CIG_REPO/libre/firmware" "$WORK/$_top/WHENCE" \
            | awk -F'\t' 'NR == FNR { want[$0] = 1; next } $1 in want' \
                  "$DEST/usr/share/cig/firmware.list" - | sort > "$DEST/usr/share/cig/firmware.licenses"
        echo "free firmware files: $(awk -F'\t' '$2 == "free"' "$DEST/usr/share/cig/firmware.licenses" | wc -l)"
    fi
}
group="base"
