# sway - tiling Wayland compositor, i3-compatible (no tray: it needs D-Bus)
name=sway
version=1.12
source="https://github.com/swaywm/sway/releases/download/$version/sway-$version.tar.gz"
signature="https://github.com/swaywm/sway/releases/download/$version/sway-$version.tar.gz.sig"
keys="34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48"
sha256="a7b1becc217433c11c6284d36bcea0687b87b77b0ed26a384565292ec321f2b1"
depends="wlroots json-c pcre2 pango cairo libinput libevdev wayland libxkbcommon seatd swaybg"
makedepends="meson pkgconf wayland-protocols"
style=meson
group="desktop"
meson_args="-Dwerror=false -Dman-pages=disabled -Dtray=disabled -Dgdk-pixbuf=disabled -Ddefault-wallpaper=false
    -Dfish-completions=false -Dzsh-completions=false -Dbash-completions=false"
config_files="etc/sway/config etc/sway/config.d/00-local.conf"

# the default config without what is not shipped (the wallpaper: -Ddefault-wallpaper=false), and
# a config.d with a file in it, so its include finds something
do_install() {
    style_install
    sed -i 's|^output \* bg /usr/share/backgrounds/.*|# (no default wallpaper; set one with "output * bg <file> fill" and swaybg)|' \
        "$DEST/etc/sway/config"
    mkdir -p "$DEST/etc/sway/config.d"
    printf '%s\n' '# Files in /etc/sway/config.d are included by /etc/sway/config.' \
        '# Put local additions here (or in ~/.config/sway/config).' > "$DEST/etc/sway/config.d/00-local.conf"
}
