# openssl - TLS library (3.5 LTS branch)
name=openssl
version=3.5.9
source="https://github.com/openssl/openssl/releases/download/openssl-$version/openssl-$version.tar.gz"
signature="https://github.com/openssl/openssl/releases/download/openssl-$version/openssl-$version.tar.gz.asc"
sha256="603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a"
depends="zlib"
makedepends="perl"
style=custom
do_build() {
    ./Configure linux-x86_64 --prefix=/usr --openssldir=/etc/ssl --libdir=lib \
        shared zlib-dynamic no-ssl3 no-weak-ssl-ciphers $LDFLAGS
    make
}
do_install() { make DESTDIR="$DEST" install_sw install_ssldirs; }
