#!/bin/sh
# startdwl - start a dwl session from a tty, as your normal user
[ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR="/run/user/$(id -u)"
[ -d "$XDG_RUNTIME_DIR" ] || { echo "no $XDG_RUNTIME_DIR - reboot once so rc.init creates it"; exit 1; }
export LIBSEAT_BACKEND=seatd
export WLR_RENDERER=pixman
# sound for the session when PipeWire is installed; it stops with dwl
pw=
if command -v pipewire-launcher >/dev/null; then
    pipewire-launcher & pw=$!
fi
dwl "$@" 2> "$XDG_RUNTIME_DIR/dwl.log"
status=$?
[ -z "$pw" ] || kill "$pw" 2>/dev/null
exit $status
