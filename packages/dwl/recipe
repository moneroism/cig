# dwl - dwm for Wayland: a small tiling compositor (upstream config, unmodified)
# The tarball is unsigned; this checksum matches an independent source
# (Arch AUR package for 0.9).
name=dwl
version=0.9
source="https://codeberg.org/dwl/dwl/releases/download/v$version/dwl-v$version.tar.gz"
sha256="51ed5da49942ca3272b6f2c4f1d7641b0b947a6eb1c264dce8a65b4d245596af"
depends="wlroots libinput libxkbcommon wayland"
makedepends="wayland-protocols pkgconf"
style=make

pre_build() {
    cp config.def.h config.h
}

do_install() {
    style_install
    install -D -m 755 "$PKGDIR/files/startdwl" "$DEST/usr/bin/startdwl"
}
group="desktop"
default=on
