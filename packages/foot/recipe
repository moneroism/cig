# foot - terminal. Upstream defaults; only login-shell is set (functional).
name=foot
version=1.28.0
source="foot-$version.tar.gz::https://codeberg.org/dnkl/foot/archive/$version.tar.gz"
sha256="4296be402b5684d049534598e69db92b918f92beac9dab76b585207045f0b037"
depends="fcft wayland pixman libxkbcommon fontconfig font-jetbrains-mono"
makedepends="tllist wayland-protocols meson python pkgconf"
style=meson
meson_args="-Ddocs=disabled -Dthemes=false -Dtests=false -Dgrapheme-clustering=disabled
    -Dterminfo=disabled -Ddefault-terminfo=xterm-256color"
do_install() {
    style_install
    mkdir -p "$DEST/etc/xdg/foot"
    printf 'login-shell=yes\n' > "$DEST/etc/xdg/foot/foot.ini"
}
group="desktop"
default=on
