+fn fallback_cfg_lines(triple_name: &'static str) -> Vec<CfgLine> {
+    let arch = match triple_name.split('-').next().unwrap_or("") {
+        "aarch64" | "arm64e" => "aarch64",
+        "arm" | "armv7" | "armv7s" | "thumbv7neon" => "arm",
+        "i386" | "i686" => "x86",
+        "riscv64gc" => "riscv64",
+        "powerpc64le" => "powerpc64",
+        other => other,
+    };
+    let t = triple_name;
+    let os = if t.contains("-darwin") {
+        "macos"
+    } else if t.contains("-ios") {
+        "ios"
+    } else if t.contains("-tvos") {
+        "tvos"
+    } else if t.contains("-android") {
+        "android"
+    } else if t.contains("-fuchsia") {
+        "fuchsia"
+    } else if t.contains("-windows") {
+        "windows"
+    } else {
+        "linux"
+    };
+    let env = if t.ends_with("-msvc") {
+        "msvc"
+    } else if t.contains("-linux-gnu") {
+        "gnu"
+    } else {
+        ""
+    };
+    let family = if os == "windows" { "windows" } else { "unix" };
+    [("target_arch", arch), ("target_os", os), ("target_env", env), ("target_family", family)]
+        .into_iter()
+        .map(|(n, v)| CfgLine {
+            triple_name,
+            property_name: n.to_string(),
+            property_value: v.to_string(),
+        })
+        .collect()
+}
