noextract=1
depends="nss at-spi2-core dbus glib mesa libxkbcommon pango cairo libudev-zero alsa-lib libffi fontconfig"
makedepends="llvm compiler-rt rust rust-bindgen nodejs gn go esbuild typescript-go python samurai gperf bison flex perl pkgconf
    hwdata"
style=custom
nostrip=1   # strip with llvm's tools (the binaries come from clang/lld)
# not an installer component until rel 2 is built (static libgcc; rel 1 linked gcc's shared
# libgcc_s, which installed systems do not have): group="desktop"
_src() { echo "$WORK/chromium-$version"; }
pre_build() {
    # Chromium's Rust code and crubit use nightly features on a stable rustc (as Alpine does)
    export RUSTC_BOOTSTRAP=1
    local s n v c f
    s=$(_src)
    xz -dc "$CIG_VAR/sources/chromium-$version-lite.tar.xz" | tar -C "$WORK" -xf -
    tar -C "$WORK" -xzf "$CIG_VAR/sources/crubit-$_crubit.tar.gz"
    cd "$s"
    # no prebuilt binaries from the tarball (everything used is built here)
    python3 - <<'PY'
import os
for root, dirs, files in os.walk('.'):
    for f in files:
        p = os.path.join(root, f)
        if os.path.islink(p): continue
        try:
            with open(p, 'rb') as h:
                if h.read(4) == b'\x7fELF': os.remove(p)
        except OSError: pass
PY
    while read -r p; do
        echo "patch: $p"; patch -p1 < "$PKGDIR/files/patches/$p.patch"
    done < "$PKGDIR/files/patches/series"
    # tsgo (TypeScript 7) from cig's typescript-go, with Chromium's lib.dom.d.ts change (as Alpine)
    rm -rf third_party/typescript/linux-amd64/src
    cp -RL /usr/lib/typescript-go/platform third_party/typescript/linux-amd64/src
    ( cd third_party/typescript/linux-amd64/src &&
        patch -p1 < ../3pp/patches/typescript_native_preview.patch )
    # rs_bindings_from_cc is not used by Chromium yet and would need Abseil and Protobuf
    sed -i 's/^ENABLE_BUILDING_RS_BINDINGS_FROM_CC = True/ENABLE_BUILDING_RS_BINDINGS_FROM_CC = False/' \
        tools/rust/build_crubit.py
    grep -q '^ENABLE_BUILDING_RS_BINDINGS_FROM_CC = False' tools/rust/build_crubit.py
    # the build tools: cig's, in the places Chromium looks for its own
    mkdir -p third_party/node/linux/node-linux-x64/bin third_party/gperf/cipd/bin
    ln -sf /usr/bin/node third_party/node/linux/node-linux-x64/bin/node
    ln -sf /usr/bin/gperf third_party/gperf/cipd/bin/gperf
    ln -sf /usr/bin/esbuild third_party/devtools-frontend/src/third_party/esbuild/esbuild
    for a in amd64 ""; do
        mkdir -p third_party/dawn/tools/golang/linux-$a/bin
        ln -sf /usr/bin/go third_party/dawn/tools/golang/linux-$a/bin/go
    done
    mkdir -p buildtools/linux64-format
    ln -sf /usr/bin/clang-format buildtools/linux64-format/clang-format
    if [ -d third_party/test_fonts/test_fonts ] && [ ! -L third_party/test_fonts/test_fonts ]; then
        rmdir third_party/test_fonts/test_fonts && ln -s ../../../ third_party/test_fonts/test_fonts
    fi
    sed -i 's|//third_party/usb_ids/usb.ids|/usr/share/hwdata/usb.ids|g' services/device/public/cpp/usb/BUILD.gn
    touch chrome/test/data/webui/i18n_process_css_test.html
    mkdir -p third_party/rust-toolchain/bin third_party/rust-toolchain/lib/third_party \
        third_party/rust-toolchain-intermediate
    for t in cargo rustc rustfmt; do ln -sf /usr/bin/$t third_party/rust-toolchain/bin/$t; done
    # the rust package's own folder: smoke's /usr links each file, and gnrt checks that std's
    # vendored crates' real paths lie under rustlib
    f=$(readlink -f /usr/lib/rustlib/src/rust/library/Cargo.lock)
    ln -sfn "${f%/src/rust/library/Cargo.lock}" third_party/rust-toolchain/lib/rustlib
    ln -sfn "$WORK/crubit-$_crubit" third_party/rust-toolchain-intermediate/crubit
    # the crates for crubit and gnrt, offline: a vendored source named by each lock's checksum
    mkdir -p "$WORK/vendor" "$WORK/cargo"
    cat "$WORK/crubit-$_crubit/Cargo.lock" tools/crates/gnrt/Cargo.lock |
    awk '/^\[\[package\]\]/{n="";v=""} /^name = /{gsub(/"/,"",$3);n=$3} /^version = /{gsub(/"/,"",$3);v=$3}
         /^checksum = /{gsub(/"/,"",$3); print n, v, $3}' | sort -u |
    while read -r n v c; do
        [ -d "$WORK/vendor/$n-$v" ] && continue
        tar -C "$WORK/vendor" -xzf "$CIG_VAR/sources/$n-$v.crate"
        printf '{"files":{},"package":"%s"}' "$c" > "$WORK/vendor/$n-$v/.cargo-checksum.json"
    done
    printf '%s\n' '[source.crates-io]' 'replace-with = "vendored"' '[source.vendored]' \
        "directory = \"$WORK/vendor\"" '[net]' 'offline = true' > "$WORK/cargo/config.toml"
    export CARGO_HOME="$WORK/cargo"
    # dynamically linked: the musl target defaults to crt-static, but crubit links rustc's
    # internals, which rustc-dev ships only as rmeta + librustc_driver.so
    export RUSTFLAGS="-Ctarget-feature=-crt-static"
    env -u CARGO_PROFILE_RELEASE_PANIC python3 tools/rust/build_crubit.py --skip-checkout
    ln -sfn "$WORK/crubit-$_crubit" third_party/rust-toolchain/lib/third_party/crubit
    rustc -V > third_party/rust-toolchain/VERSION
    cp third_party/rust-toolchain/VERSION third_party/rust-toolchain/INSTALLED_VERSION
    ( cd tools/crates/gnrt && cargo build --locked --release --offline )
    tools/crates/gnrt/target/release/gnrt gen --for-std third_party/rust-toolchain/lib/rustlib/src/rust
    echo x86_64-unknown-linux-musl >> build/rust/known-target-triples.txt
}
do_build() {
    cd "$(_src)"
    export CC=clang CXX=clang++ AR=llvm-ar NM=llvm-nm CARGO_HOME="$WORK/cargo"
    # one line each: the unbundle toolchain writes them into the ninja files
    local w="-O2 -Wno-unknown-warning-option -Wno-builtin-macro-redefined -Wno-deprecated-declarations"
    export CFLAGS="$w -Wno-shift-count-overflow -Wno-ignored-attributes"
    export CXXFLAGS="$w -Wno-invalid-constexpr"
    export RUSTC_BOOTSTRAP=1
    # musl has no <sys/cdefs.h>: a small stand-in (files/compat)
    export CPPFLAGS="-D__DATE__= -D__TIME__= -D__TIMESTAMP__= -isystem $PKGDIR/files/compat"
    export ESBUILD_BINARY_PATH=/usr/bin/esbuild
    # libgcc statically (as mesa): its shared libgcc_s belongs to gcc, which installed systems
    # do not have. Only the link steps change (rel 2 relinked the rel 1 tree)
    export LDFLAGS="$LDFLAGS -static-libgcc"
    gn gen out/Release --args="
        is_official_build=true is_debug=false symbol_level=0 chrome_pgo_phase=0
        is_clang=true clang_base_path=\"/usr\" clang_version=\"23\" clang_use_chrome_plugins=false
        custom_toolchain=\"//build/toolchain/linux/unbundle:default\"
        host_toolchain=\"//build/toolchain/linux/unbundle:default\"
        use_sysroot=false use_custom_libcxx=true use_safe_libstdcxx=false use_clang_modules=false
        is_musl=true use_thin_lto=false is_cfi=false use_mold=false treat_warnings_as_errors=false
        fatal_linker_warnings=false enable_stripping=false enable_nocompile_tests=false
        enable_rust=true rustc_version=\"yes\" rust_bindgen_root=\"/usr\"
        ozone_auto_platforms=false ozone_platform_wayland=true ozone_platform_x11=false
        ozone_platform=\"wayland\" use_gtk=false use_qt=false use_qt6=false
        use_cups=false use_kerberos=false use_pulseaudio=false use_vaapi=false rtc_use_pipewire=false
        proprietary_codecs=false ffmpeg_branding=\"Chromium\" use_system_libffi=true use_bundled_fontconfig=false use_libpci=false
        use_typescript_go=false node_version_check=false icu_use_data_file=false
        disable_fieldtrial_testing_config=true safe_browsing_use_unrar=false
        enable_hangout_services_extension=false enable_vr=false v8_use_metagen=false
        blink_enable_generated_code_formatting=false"
    ulimit -n 4096
    # at most 3 jobs: the linker and the big translation units need the memory
    samu -C out/Release -j3 chrome chrome_sandbox chrome_crashpad_handler
}
do_install() {
    local o="$(_src)/out/Release" l="$DEST/usr/lib/chromium" f
    mkdir -p "$l/locales" "$DEST/usr/bin"
    install -m 755 "$o/chrome" "$l/chromium"
    install -m 755 "$o/chrome_sandbox" "$l/chrome-sandbox"
    install -m 755 "$o/chrome_crashpad_handler" "$l/"
    for f in snapshot_blob.bin v8_context_snapshot.bin icudtl.dat libEGL.so libGLESv2.so \
             libvk_swiftshader.so vk_swiftshader_icd.json libvulkan.so.1; do
        [ -f "$o/$f" ] && install -m 644 "$o/$f" "$l/"
    done
    chmod 755 "$l"/*.so* 2>/dev/null || true
    install -m 644 "$o"/*.pak "$l/"
    install -m 644 "$o"/locales/*.pak "$l/locales/"
    [ -d "$o/MEIPreload" ] && cp -R "$o/MEIPreload" "$l/"
    llvm-strip --strip-unneeded "$l/chromium" "$l/chrome-sandbox" "$l/chrome_crashpad_handler" "$l"/*.so* 2>/dev/null || true
    printf '%s\n' '#!/bin/sh' '# chromium - start Chromium (Wayland)' \
        'exec /usr/lib/chromium/chromium --ozone-platform=wayland "$@"' > "$DEST/usr/bin/chromium"
    chmod 755 "$DEST/usr/bin/chromium"
}
post_install() {
    chown root:root /usr/lib/chromium/chrome-sandbox
    chmod 4755 /usr/lib/chromium/chrome-sandbox
}
