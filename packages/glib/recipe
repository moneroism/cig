# glib - GLib, the GNOME base library (needed by pango; no introspection, no D-Bus services)
name=glib
version=2.90.0
rel=2
source="https://download.gnome.org/sources/glib/${version%.*}/glib-$version.tar.xz"
sha256="17d15cac2af80a33271127408e0abc2748eb297c595c2a26409e81e14e7d1b8f"
depends="libffi zlib pcre2 elfutils"
makedepends="meson pkgconf python python-packaging"
style=meson
meson_args="-Dintrospection=disabled -Dtests=false -Dnls=disabled -Dman-pages=disabled
    -Ddocumentation=false -Dselinux=disabled -Dlibmount=disabled -Dsysprof=disabled
    -Ddtrace=disabled -Dsystemtap=disabled -Dglib_debug=disabled"
