# ca-certificates - Mozilla's trusted root certificates (via curl.se)
# version = date this bundle snapshot was taken
name=ca-certificates
version=2026.11.05
license="MPL-2.0"
_file="cacert-${version//./-}.pem"   # the dated bundle: a pin never meets another snapshot under the same name
source="https://curl.se/ca/$_file"
sha256="427c064216761a1e72a8b30f0d954d08cb6e4435a82091fb865afd20c8497285"
style=custom
do_build() { :; }
do_install() {
    install -D -m 644 "$_file" "$DEST/etc/ssl/cert.pem"
    mkdir -p "$DEST/etc/ssl/certs"
    ln -sf ../cert.pem "$DEST/etc/ssl/certs/ca-certificates.crt"
}
# updates: the bundle is dated (cacert-2026-10-02.pem); curl's page names the current one
upstream_version() {
    curl -fsL --proto '=https' --tlsv1.2 --max-time 20 https://curl.se/docs/caextract.html \
        | grep -oE 'cacert-[0-9]{4}-[0-9]{2}-[0-9]{2}' | sed 's/cacert-//; s/-/./g'
}
