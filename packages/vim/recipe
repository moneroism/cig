# vim - the Vi IMproved text editor (terminal only)
name=vim
version=9.2.1164
source="vim-$version.tar.gz::https://github.com/vim/vim/archive/refs/tags/v$version.tar.gz"
sha256="38d61152e0ab48f0f8b2ce387119310469c2bf50e486adcc648750f85ba5af7c"
depends="ncurses"
style=gnu
group="tools"
# terminal editor only: no GUI, X11, sound, network protocols or translations
configure_args="--with-features=normal --enable-gui=no --without-x --disable-nls --disable-canberra
    --disable-libsodium --disable-netbeans --disable-channel --disable-gpm --disable-sysmouse
    --with-tlib=ncursesw"
