do_build() {
    local e f p
    # the modules as a module proxy directory: <module>/@v/<version>.zip|.mod, as in their URLs
    for e in $source; do
        case "$e" in gomod-*) ;; *) continue ;; esac
        f=${e%%::*}; p=${e#*proxy.golang.org/}
        mkdir -p "$WORK/goproxy/${p%/*}"
        cp "$CIG_VAR/sources/$f" "$WORK/goproxy/$p"
    done
    CGO_ENABLED=0 GOFLAGS=-mod=mod GOTOOLCHAIN=local GOTELEMETRY=off GOSUMDB=off \
        GOPROXY="file://$WORK/goproxy" GOPATH="$WORK/gopath" GOCACHE="$WORK/gocache" \
        go build -trimpath -tags=noembed \
        -ldflags="-s -w -X github.com/microsoft/typescript-go/internal/core.version=$version" \
        -o built/local/tsc ./cmd/tsgo
}
do_install() {
    # the layout of npm's @typescript/typescript-linux-x64 (binary and lib.*.d.ts in lib/),
    # which Chromium's third_party/typescript expects
    local l="$DEST/usr/lib/typescript-go/platform/lib"
    install -D -m 755 built/local/tsc "$l/tsc"
    cp -R internal/bundled/libs/. "$l/"
    "$l/tsc" --version    # noembed: it finds its lib.*.d.ts next to itself
    mkdir -p "$DEST/usr/bin"
    ln -s ../lib/typescript-go/platform/lib/tsc "$DEST/usr/bin/tsgo"
}
