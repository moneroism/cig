# binutils - assembler, linker, object tools
name=binutils
version=2.47
source="https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz"
signature="https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz.sig"
keys="3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F"
sha256="-"
depends="zlib"
style=custom
do_build() {
    mkdir build && cd build
    ../configure --prefix=/usr --sysconfdir=/etc \
        --build=x86_64-pc-linux-musl --host=x86_64-pc-linux-musl --target=x86_64-pc-linux-musl \
        --enable-ld=default --enable-plugins --enable-shared \
        --disable-werror --disable-nls --enable-gprofng=no --with-system-zlib \
        --enable-64-bit-bfd --enable-new-dtags --enable-default-hash-style=gnu
    make tooldir=/usr MAKEINFO=true
}
do_install() { cd build && make tooldir=/usr MAKEINFO=true DESTDIR="$DEST" install; }
