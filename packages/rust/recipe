style=custom
pre_build() {
    local p v
    # alpine-target first: the musl targets without self-contained CRT objects, which
    # remove-musl-root then deletes
    for p in alpine-target do-not-install-libunwind-source gcc-eh-libunwind install-template-shebang \
             no-export-ld-library-path remove-musl-root libc-cfg; do
        patch -p1 < "$WORK/src/$p.patch"
    done
    # rustix is not compatible with musl 1.2's statx flags; cargo's checksums of the patched
    # crates are cleared (as Alpine does)
    for v in 1.1.2 1.1.4; do
        [ -d "vendor/rustix-$v" ] || continue
        ( cd "vendor/rustix-$v" && patch -p1 < "$WORK/src/rustix-$v-statx_flags.diff" )
        sed -i 's/"files":{[^}]*}/"files":{}/' "vendor/rustix-$v/.cargo-checksum.json"
    done
    # the seed: upstream's previous release, unpacked here only to build this one
    # (cigbuild unpacked it next to the source)
    sh "$WORK/src/rust-$_seed-x86_64-unknown-linux-musl/install.sh" --prefix="$WORK/seed" \
        --disable-ldconfig --components=rustc,cargo,rust-std-x86_64-unknown-linux-musl >/dev/null
}
do_build() {
    local t=x86_64-unknown-linux-musl
    export RUST_MIN_STACK=16777216   # LLVM 23 needs a larger thread stack (Alpine)
    ./configure --build=$t --host=$t --target=$t --prefix=/usr --release-channel=stable \
        --local-rust-root="$WORK/seed" --enable-local-rust --disable-docs --enable-extended \
        --tools=cargo,src,rustfmt --enable-llvm-link-shared --enable-locked-deps \
        --enable-profiler --enable-vendor --dist-compression-formats=gz --python=python3 \
        --set=rust.codegen-units-std=1 --set=rust.deny-warnings=false --set=rust.lld=false \
        --set=rust.incremental=false --set=rust.remap-debuginfo=true \
        --set=target.$t.llvm-config=/usr/bin/llvm-config --set=target.$t.crt-static=false \
        --set=target.$t.cc=cc --set=target.$t.cxx=c++ --set=target.$t.ar=ar --set=target.$t.linker=cc
    python3 ./x.py dist --jobs "$(nproc)" rustc rust-std cargo rust-src rustfmt rustc-dev
}
do_install() {
    local c
    for c in rustc rust-std cargo rust-src rustfmt rustc-dev; do
        for d in build/dist/$c-*.tar.gz; do
            tar -C "$WORK" -xzf "$d"
            sh "$WORK/$(basename "$d" .tar.gz)/install.sh" --prefix=/usr --destdir="$DEST" \
                --disable-ldconfig >/dev/null
        done
    done
    rm -f "$DEST"/usr/lib/rustlib/install.log "$DEST"/usr/lib/rustlib/uninstall.sh \
          "$DEST"/usr/lib/rustlib/manifest-* "$DEST"/usr/lib/rustlib/components
}
