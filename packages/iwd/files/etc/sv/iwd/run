#!/bin/sh
# iwd does its cryptography through the kernel (AF_ALG): load those interfaces first
modprobe -q algif_hash 2>/dev/null
modprobe -q algif_skcipher 2>/dev/null
# iwd talks through the system bus: wait for it
sv check dbus >/dev/null || exit 1
/usr/lib/iwd/iwd 2>&1
# it stopped (e.g. a kernel without AF_ALG, see /var/log/iwd): no restart every second
sleep 30
