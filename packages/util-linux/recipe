# util-linux - only sfdisk (GPT partitioning for the installer) and its libraries.
# Also provides libuuid and libblkid (used by e2fsprogs).
name=util-linux
version=2.41.6
source="https://cdn.kernel.org/pub/linux/utils/util-linux/v${version%.*}/util-linux-$version.tar.xz"
signature="https://cdn.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-$version.tar.sign"
sha256="e596083744e746be7d2823b62b43f4418dd7bf56303b4dc09e6fe8112fe3d7ed"

makedepends="pkgconf"
style=custom
do_build() {
    ./configure --prefix=/usr --disable-static \
        --disable-all-programs --enable-libsmartcols --enable-libfdisk --enable-fdisks --disable-cfdisk \
        --enable-libuuid --enable-libblkid --disable-libmount \
        --without-python --without-systemd --without-udev --without-ncurses --without-ncursesw \
        --without-readline --without-tinfo --without-btrfs --disable-nls \
        --disable-bash-completion --disable-asciidoc \
        --disable-makeinstall-chown --disable-makeinstall-setuid
    make
}
do_install() { make DESTDIR="$DEST" install; }
group="base"


# corrected: the error lines are case branches ending in ";;"
pre_build() {
    sed -i -E 's/as_fn_error [^"]*"cfdisk selected[^"]*" "\$LINENO" 5/build_cfdisk=no/' configure
    if grep -q 'as_fn_error.*cfdisk selected' configure; then echo "cfdisk patch did not apply"; exit 1; fi
}
