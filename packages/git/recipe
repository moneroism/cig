# git - version control (2.x: no Rust)
name=git
version=2.56.0
# track 2: git 3.0 makes Rust mandatory (README)
track=2
source="https://cdn.kernel.org/pub/software/scm/git/git-$version.tar.xz"
signature="https://cdn.kernel.org/pub/software/scm/git/git-$version.tar.sign"
keys="96E07AF25771955980DAD10020D04E5A713660A7"
sha256="26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3"
depends="curl zlib openssl"
style=custom
_opts="prefix=/usr NO_PERL=1 NO_PYTHON=1 NO_TCLTK=1 NO_GETTEXT=1 NO_EXPAT=1
       NO_REGEX=NeedsStartEnd NO_RUST=1 INSTALL_SYMLINKS=1"
do_build()   { make $_opts; }
do_install() { make $_opts DESTDIR="$DEST" install; }
group="development"
