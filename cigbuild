#
# cigbuild - build, package, install and remove cig packages.
# Runs inside cig itself (chroot, installer, installed system).
# Needs only bash, curl and BusyBox.
#
#   cigbuild build   <pkg>...   fetch + verify + build + package (deps first)
#   cigbuild install <pkg>...   same as: smoke add -c -y
#   cigbuild rebuild <pkg>...   build again from source, smoke switches over
#   cigbuild fetch   <pkg>...   download + verify sources only
#   cigbuild pin     <pkg>...   fill in missing sha256 values in a recipe
#   cigbuild sig     <pkg> <url|->...  verify pinned sources against upstream signatures, record the URLs
#   cigbuild keys    <pkg>...   verify pinned sources again, record their signing keys (keys=)
#   cigbuild trust   <pkg> <fpr>  accept one more signing key (after checking it independently)
#   cigbuild sigonly <pkg>...   signed sources: verify, then drop the pinned sha256 (gpgv decides)
#   cigbuild latest  <pkg>...   newest upstream release (track= limits it to a series)
#   cigbuild info    <pkg>      show what a recipe contains
#   cigbuild pkgfile <pkg>      path of the package file for the current recipe
#
# Installing and removing is smoke's job: smoke install / remove / list / audit

set -euo pipefail

CIG_REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CIG_VAR="${CIG_VAR:-/var/cig}"
. "$CIG_REPO/lib/common.sh"
. "$CIG_REPO/lib/styles.sh"

usage() { sed -n '8,23p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

cmd=${1:-}; shift || true
[ -n "$cmd" ] || usage

case "$cmd" in
    build)   [ $# -gt 0 ] || usage; for p in "$@"; do pkg_build "$p"; done ;;
    install) [ $# -gt 0 ] || usage; exec "$SMOKE" add -c -y "$@" ;;
    rebuild) [ $# -gt 0 ] || usage; for p in "$@"; do pkg_rebuild "$p"; done ;;
    remove)  exec "$SMOKE" remove "$@" ;;
    pkgfile) [ $# -eq 1 ] || usage; load_recipe "$1"; echo "$PKGFILE" ;;
    meta)    [ $# -eq 1 ] || usage; pkg_meta "$1" ;;
    fetch)   [ $# -gt 0 ] || usage; for p in "$@"; do load_recipe "$p"; fetch_sources; done ;;
    pin)     [ $# -gt 0 ] || usage; for p in "$@"; do pkg_pin "$p"; done ;;
    sig)     [ $# -gt 1 ] || usage; pkg_sig "$@" ;;
    keys)    [ $# -gt 0 ] || usage; for p in "$@"; do pkg_keys "$p"; done ;;
    trust)   [ $# -eq 2 ] || usage; pkg_trust "$1" "$2" ;;
    sigonly) [ $# -gt 0 ] || usage; for p in "$@"; do pkg_sigonly "$p"; done ;;
    latest)  [ $# -gt 0 ] || usage   # several packages: 8 at a time, lines in any order
             if [ $# -eq 1 ]; then pkg_latest "$1"; else printf '%s\n' "$@" | xargs -P 8 -n 1 "$0" latest; fi ;;
    info)    [ $# -eq 1 ] || usage; pkg_info "$1" ;;
    list)    pkg_list ;;
    *)       usage ;;
esac
