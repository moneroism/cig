#
# cig-install - install cig onto a disk. Run as root on a running cig system
# (the install media, or for testing a VM with a second, empty disk).
#
# Menus are numbered; checklists toggle with the item number. Nothing is
# written to any disk before the final confirmation.

set -euo pipefail
umask 022

CIG_SHARE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"   # cigbuild, smoke, packages
VERSION=$(cat "$CIG_SHARE/VERSION" 2>/dev/null || echo unknown)
CIGBUILD="$CIG_SHARE/cigbuild"
SMOKE="$CIG_SHARE/smoke"
T=/mnt/cig-target
LOG=/var/log/cig-install.log
WORK=/tmp/cig-install
export CIG_VAR="${CIG_VAR:-/var/cig}"

# ---------------- choices (filled by the screens) ----------------
DISK="" ROOT_SIZE="40" SEP_HOME=yes SWAP_SIZE=0
HOSTNAME_="cig" USERNAME="" USERPASS="" ROOTMODE=lock ROOTPASS=""
BUILD_MODE=compile KERNEL_MODE=compile
WIFI_SSID="" WIFI_PSK=""
declare -a PKG_NAMES=() PKG_GROUP=() PKG_ON=() PKG_DESC=()
declare -a DRV_NAMES=() DRV_FILES=() DRV_ON=()
BASE_PKGS=""

# ---------------- UI helpers ----------------
hr()    { printf '%s\n' "------------------------------------------------------------"; }
title() { clear 2>/dev/null || true; echo "cig $VERSION installer"; hr; echo "$*"; hr; }
die()   { echo; echo "!! $*" >&2; exit 1; }
pause() { read -r -p "Press Enter to continue " _; }

ask() {   # ask <prompt> <default> -> REPLY
    local d=$2
    read -r -p "$1${d:+ [$d]}: " REPLY
    [ -n "$REPLY" ] || REPLY=$d
}

ask_secret() {   # ask_secret <prompt> -> REPLY (asked twice)
    local a b
    while :; do
        read -r -s -p "$1: " a; echo
        [ -n "$a" ] || { echo "  empty, try again"; continue; }
        read -r -s -p "repeat: " b; echo
        [ "$a" = "$b" ] && { REPLY=$a; return; }
        echo "  did not match, try again"
    done
}

yesno() {   # yesno <prompt> <default y|n>
    local r
    read -r -p "$1 [$( [ "$2" = y ] && echo Y/n || echo y/N )]: " r
    r=${r:-$2}
    case "$r" in y|Y|yes) return 0 ;; *) return 1 ;; esac
}

# ---------------- checks ----------------
preflight() {
    [ "$(id -u)" -eq 0 ] || die "run as root"
    [ -d /sys/firmware/efi ] || die "this machine did not boot in UEFI mode; cig needs UEFI"
    local c
    for c in sfdisk blkid mkfs.vfat mkfs.ext4 mkswap mountpoint chpasswd adduser; do
        command -v "$c" >/dev/null || die "missing tool: $c"
    done
    [ -x "$CIGBUILD" ] && [ -x "$SMOKE" ] || die "cigbuild/smoke not found next to the installer"
    mkdir -p "$WORK"
    # long builds: keep the console from blanking while the installer runs
    echo 0 > /sys/module/kernel/parameters/consoleblank 2>/dev/null || true
    printf '\033[9;0]' 2>/dev/null || true
}

# ---------------- screen 1: disk ----------------
size_h() {   # bytes -> 512M / 40G / 1.8T (binary units, as sizes are entered)
    awk -v b="$1" 'BEGIN { if (b >= 2^40) printf "%.1fT", b/2^40; else if (b >= 2^30) printf "%.0fG", b/2^30; else printf "%.0fM", b/2^20 }'
}

system_disk() {   # the disk this system runs from (never offered)
    local mm d p
    mm=$(mountpoint -d /)
    for p in /sys/class/block/*; do
        [ "$(cat "$p/dev" 2>/dev/null)" = "$mm" ] || continue
        if [ -f "$p/partition" ]; then d=$(basename "$(readlink -f "$p/..")"); else d=$(basename "$p"); fi
        echo "$d"; return
    done
}

# The layout is a list of partitions, one index per partition in the L_* arrays.
# Existing partitions keep their place; new ones go into free space (first fit,
# "rest" takes the largest gap). Nothing is written before the summary; then the
# whole table is written with one sfdisk call.
FS_LINUX=(ext4)     # filesystems offered for / and /home (more once kernel and recipes support them)
L_ARRAYS="L_NUM L_NEW L_START L_SIZE L_KIND L_FS L_MKFS L_MOUNT L_FORMAT L_LINE L_NAME"
declare -a L_NUM=() L_NEW=() L_START=() L_SIZE=() L_KIND=() L_FS=() L_MKFS=() L_MOUNT=() L_FORMAT=() L_LINE=() L_NAME=()
declare -a P_START=() P_SIZE=() P_NUM=()   # computed by layout_place
declare -A ORIG=()                         # partitions on the disk before: number -> description
WIPE=yes SECT=512 ALIGN=2048 FIRST=2048 LAST=0 FREE=0 HEADER="" PLACE_ERR=""
TYPE_ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
TYPE_LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
TYPE_SWAP=0657FD6D-A4AB-43C4-84E5-0933C84B4F4F

parse_size() {   # parse_size <512M|40G|1T|rest> -> REPLY in sectors (0 = rest)
    local n u
    case "$1" in rest) REPLY=0; return 0 ;; esac
    [[ "$1" =~ ^([0-9]+)([MmGgTt])$ ]] || return 1
    n=${BASH_REMATCH[1]}
    case "${BASH_REMATCH[2]}" in [Mm]) u=$((1 << 20)) ;; [Gg]) u=$((1 << 30)) ;; *) u=$((1 << 40)) ;; esac
    [ "$n" -gt 0 ] || return 1
    REPLY=$(( n * u / SECT ))
}

disk_geometry() {   # sector size, alignment (1 MiB) and the usable GPT area of $DISK
    local total
    SECT=$(cat "/sys/block/$DISK/queue/logical_block_size" 2>/dev/null || echo 512)
    ALIGN=$(( 1048576 / SECT ))
    total=$(( $(cat "/sys/block/$DISK/size") * 512 / SECT ))
    FIRST=$ALIGN
    LAST=$(( total - 2 - 16384 / SECT ))   # backup GPT: header + 16 KiB of entries
}

layout_clear() { local -n a; for a in $L_ARRAYS; do a=(); done; ORIG=(); }

layout_new() {   # layout_new <esp|linux|swap> <sectors, 0 = rest> <mount point>
    local fs
    case "$1" in esp) fs=vfat ;; swap) fs=swap ;; *) fs=${FS_LINUX[0]} ;; esac
    L_NUM+=(""); L_NEW+=(yes); L_START+=(0); L_SIZE+=("$2"); L_KIND+=("$1"); L_FS+=("")
    L_MKFS+=("$fs"); L_MOUNT+=("$3"); L_FORMAT+=(yes); L_LINE+=(""); L_NAME+=("")
}

layout_del() { local -n a; for a in $L_ARRAYS; do a=("${a[@]:0:$1}" "${a[@]:$(( $1 + 1 ))}"); done; }

layout_load() {   # the disk's current GPT; without one, start from an empty disk
    local dump line dev num type name fs kind
    layout_clear; disk_geometry; WIPE=yes; HEADER=""
    dump=$(sfdisk -d "/dev/$DISK" 2>/dev/null || true)
    if ! grep -q '^label: gpt' <<< "$dump"; then
        [ -z "$dump" ] || { echo "  /dev/$DISK has no GPT partition table: starting from an empty disk"; pause; }
        return 0
    fi
    WIPE=no
    HEADER=$(grep -E '^(label|label-id|unit|first-lba|last-lba|sector-size):' <<< "$dump" || true)
    FIRST=$(sed -n 's/^first-lba: *//p' <<< "$dump"); FIRST=${FIRST:-$ALIGN}
    num=$(sed -n 's/^last-lba: *//p' <<< "$dump"); LAST=${num:-$LAST}
    while read -r line; do
        dev=${line%% *}
        [[ "$dev" =~ ([0-9]+)$ ]] || continue
        num=${BASH_REMATCH[1]}
        type=$(sed -n 's/.*type= *\([^,]*\).*/\1/p' <<< "$line"); type=${type^^}
        name=$(sed -n 's/.*name="\([^"]*\)".*/\1/p' <<< "$line")
        fs=$(blkid "$dev" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p')
        case "$type" in $TYPE_ESP) kind=esp ;; $TYPE_LINUX) kind=linux ;; $TYPE_SWAP) kind=swap ;; *) kind=other ;; esac
        L_NUM+=("$num"); L_NEW+=(no); L_KIND+=("$kind"); L_FS+=("$fs"); L_MKFS+=("${fs:-}")
        L_START+=("$(sed -n 's/.*start= *\([0-9]*\).*/\1/p' <<< "$line")")
        L_SIZE+=("$(sed -n 's/.*size= *\([0-9]*\).*/\1/p' <<< "$line")")
        L_MOUNT+=(""); L_FORMAT+=(no); L_LINE+=("$line"); L_NAME+=("$name")
        case "$kind" in linux) L_MKFS[-1]=${FS_LINUX[0]} ;; esp) L_MKFS[-1]=vfat ;; swap) L_MKFS[-1]=swap ;; esac
        ORIG[$num]="$(basename "$dev") ${fs:-unformatted}${name:+ \"$name\"}"
    done < <(grep '^/dev/' <<< "$dump")
}

layout_auto() {   # the default layout: ESP, system, optional swap, optional /home
    layout_clear; disk_geometry; WIPE=yes; HEADER=""
    layout_new esp $(( (512 << 20) / SECT )) /boot
    if [ "$SEP_HOME" = yes ]; then
        layout_new linux $(( (ROOT_SIZE << 30) / SECT )) /
        [ "$SWAP_SIZE" -eq 0 ] || layout_new swap $(( (SWAP_SIZE << 30) / SECT )) swap
        layout_new linux 0 /home
    else
        layout_new linux 0 /
        [ "$SWAP_SIZE" -eq 0 ] || layout_new swap $(( (SWAP_SIZE << 30) / SECT )) swap
    fi
}

layout_place() {   # start, size and number for every partition -> P_*, FREE; PLACE_ERR on failure
    local i j s e n best bi rests=0
    local -a gs=() ge=() ks=() ke=()
    local -A used=()
    P_START=() P_SIZE=() P_NUM=() FREE=0 PLACE_ERR=""
    while read -r s e; do ks+=("$s"); ke+=("$e"); done < <(
        for i in "${!L_KIND[@]}"; do
            if [ "${L_NEW[$i]}" = no ]; then echo "${L_START[$i]} $(( L_START[i] + L_SIZE[i] - 1 ))"; fi
        done | sort -n)
    s=$FIRST                                     # free gaps between the kept partitions
    for j in "${!ks[@]}"; do
        if [ "${ks[$j]}" -gt "$s" ]; then gs+=("$s"); ge+=($(( ks[j] - 1 ))); fi
        if [ $(( ke[j] + 1 )) -gt "$s" ]; then s=$(( ke[j] + 1 )); fi
    done
    if [ "$s" -le "$LAST" ]; then gs+=("$s"); ge+=("$LAST"); fi

    for i in "${!L_KIND[@]}"; do                 # kept ones stay, fixed sizes first fit
        if [ "${L_NEW[$i]}" = no ]; then
            P_START[i]=${L_START[$i]}; P_SIZE[i]=${L_SIZE[$i]}; P_NUM[i]=${L_NUM[$i]}; used[${L_NUM[$i]}]=1
            continue
        fi
        if [ "${L_SIZE[$i]}" -eq 0 ]; then rests=$((rests + 1)); continue; fi
        bi=-1
        for j in "${!gs[@]}"; do
            s=$(( (gs[j] + ALIGN - 1) / ALIGN * ALIGN ))
            if [ $(( ge[j] - s + 1 )) -ge "${L_SIZE[$i]}" ]; then bi=$j; break; fi
        done
        if [ "$bi" -lt 0 ]; then PLACE_ERR="not enough free space for partition $((i + 1))"; return 1; fi
        P_START[i]=$s; P_SIZE[i]=${L_SIZE[$i]}; gs[bi]=$(( s + L_SIZE[i] ))
    done
    if [ "$rests" -gt 1 ]; then PLACE_ERR="only one partition can take the rest of the disk"; return 1; fi
    for i in "${!L_KIND[@]}"; do                 # "rest": the largest gap left
        [ "${L_NEW[$i]}" = yes ] && [ "${L_SIZE[$i]}" -eq 0 ] || continue
        bi=-1 best=0
        for j in "${!gs[@]}"; do
            s=$(( (gs[j] + ALIGN - 1) / ALIGN * ALIGN )); n=$(( (ge[j] - s + 1) / ALIGN * ALIGN ))
            if [ "$n" -gt "$best" ]; then best=$n; bi=$j; fi
        done
        if [ "$bi" -lt 0 ]; then PLACE_ERR="no free space left for partition $((i + 1))"; return 1; fi
        P_START[i]=$(( (gs[bi] + ALIGN - 1) / ALIGN * ALIGN )); P_SIZE[i]=$best; gs[bi]=$(( P_START[i] + best ))
    done
    for j in "${!gs[@]}"; do
        s=$(( (gs[j] + ALIGN - 1) / ALIGN * ALIGN ))
        if [ $(( ge[j] - s + 1 )) -ge "$ALIGN" ]; then FREE=$(( FREE + ge[j] - s + 1 )); fi
    done
    while read -r s i; do                        # new partitions get the lowest free numbers
        n=1; while [ -n "${used[$n]:-}" ]; do n=$((n + 1)); done
        used[$n]=1; P_NUM[i]=$n
    done < <(for i in "${!L_KIND[@]}"; do if [ "${L_NEW[$i]}" = yes ]; then echo "${P_START[$i]} $i"; fi; done | sort -n)
}

eff_fs() { if [ "${L_FORMAT[$1]}" = yes ]; then echo "${L_MKFS[$1]}"; else echo "${L_FS[$1]}"; fi; }

part_name() {   # GPT name for partition $1: our names for what cig uses; old cig names elsewhere renamed
    case "${L_MOUNT[$1]}" in
        /) echo cig-root ;; /home) echo cig-home ;; swap) echo cig-swap ;;
        /boot) [ "${L_NEW[$1]}" = no ] || echo ESP ;;
        *) case "${L_NAME[$1]}" in cig-root|cig-home|cig-swap) echo "${L_NAME[$1]}-old" ;; esac ;;
    esac
}

table_script() {   # the complete new partition table, as sfdisk input (needs layout_place)
    local i line name type
    if [ "$WIPE" = yes ]; then printf 'label: gpt\nunit: sectors\n'; else echo "$HEADER"; fi
    for i in $(for i in "${!L_KIND[@]}"; do echo "${P_NUM[$i]} $i"; done | sort -n | cut -d' ' -f2); do
        name=$(part_name "$i")
        if [ "${L_NEW[$i]}" = yes ]; then
            case "${L_KIND[$i]}" in esp) type=$TYPE_ESP ;; swap) type=$TYPE_SWAP ;; *) type=$TYPE_LINUX ;; esac
            echo "$(part "${P_NUM[$i]}") : start=${P_START[$i]}, size=${P_SIZE[$i]}, type=$type${name:+, name=\"$name\"}"
        else
            line=${L_LINE[$i]}
            if [ -n "$name" ]; then
                case "$line" in
                    *'name="'*) line=$(sed "s/name=\"[^\"]*\"/name=\"$name\"/" <<< "$line") ;;
                    *)          line="$line, name=\"$name\"" ;;
                esac
            fi
            echo "$line"
        fi
    done
}

layout_show() {
    local i dev size act
    layout_place || true
    printf '  %-2s %-14s %-12s %-6s %-6s %-6s %s\n' '#' partition size type fs mount action
    for i in "${!L_KIND[@]}"; do
        size=$(size_h $(( ${P_SIZE[$i]:-${L_SIZE[$i]}} * SECT )))
        if [ "${L_NEW[$i]}" = yes ]; then
            dev=new; act="create"
            [ "${L_SIZE[$i]}" -ne 0 ] || size="rest${P_SIZE[$i]:+ ($size)}"
        else
            dev=$(basename "$(part "${L_NUM[$i]}")")
            if [ "${L_FORMAT[$i]}" = yes ]; then act=FORMAT; else act=keep; fi
        fi
        printf '  %-2s %-14s %-12s %-6s %-6s %-6s %s%s\n' $((i + 1)) "$dev" "$size" "${L_KIND[$i]}" \
            "$(eff_fs "$i" | sed 's/^$/-/')" "${L_MOUNT[$i]:--}" "$act" "${L_NAME[$i]:+  \"${L_NAME[$i]}\"}"
    done
    for i in "${!ORIG[@]}"; do
        [[ " ${L_NUM[*]} " == *" $i "* ]] || echo "  -  ${ORIG[$i]}: DELETE"
    done
    if [ -n "$PLACE_ERR" ]; then echo "  !! $PLACE_ERR"; else echo "  unused space: $(size_h $(( FREE * SECT )))"; fi
}

layout_brief() {   # one line for the summary
    local i out=""
    [ "$WIPE" = yes ] && out="erase disk; "
    for i in "${!L_KIND[@]}"; do
        [ -n "${L_MOUNT[$i]}" ] || [ "${L_NEW[$i]}" = yes ] || continue
        out="$out${L_MOUNT[$i]:-unused} $(size_h $(( P_SIZE[i] * SECT ))) $(eff_fs "$i")"
        if [ "${L_NEW[$i]}" = yes ]; then out="$out new, "
        elif [ "${L_FORMAT[$i]}" = yes ]; then out="$out format, "
        else out="$out keep, "; fi
    done
    echo "${out%, }"
}

layout_check() {   # 0 if the layout can be installed; prints the problems otherwise
    local i m fs err="" out n_root=0 n_boot=0 n_home=0 n_swap=0
    layout_place || err="$err\n  $PLACE_ERR"
    for i in "${!L_KIND[@]}"; do
        m=${L_MOUNT[$i]}; fs=$(eff_fs "$i")
        case "$m:${L_KIND[$i]}" in
            :*|/:linux|/home:linux|/boot:esp|swap:swap) ;;
            *) err="$err\n  partition $((i + 1)): a ${L_KIND[$i]} partition can't be $m" ;;
        esac
        case "$m" in
            /)     n_root=$((n_root + 1))
                   [ "${L_FORMAT[$i]}" = yes ] || err="$err\n  the system partition (/) must be formatted"
                   [ -z "$PLACE_ERR" ] && [ $(( P_SIZE[i] * SECT >> 30 )) -lt 20 ] && err="$err\n  the system partition (/) needs at least 20G" ;;
            /home) n_home=$((n_home + 1))
                   [[ " ${FS_LINUX[*]} " == *" $fs "* ]] || err="$err\n  /home: no ${FS_LINUX[*]} filesystem to keep; format it" ;;
            /boot) n_boot=$((n_boot + 1))
                   [ "$fs" = vfat ] || err="$err\n  /boot (ESP): no FAT filesystem to keep; format it"
                   [ -z "$PLACE_ERR" ] && [ $(( P_SIZE[i] * SECT >> 20 )) -lt 100 ] && err="$err\n  the ESP needs at least 100M" ;;
            swap)  n_swap=$((n_swap + 1))
                   [ "$fs" = swap ] || err="$err\n  swap: not a swap partition yet; format it" ;;
        esac
    done
    [ "$n_root" -eq 1 ] || err="$err\n  exactly one partition must be mounted at /"
    [ "$n_boot" -eq 1 ] || err="$err\n  exactly one ESP must be mounted at /boot"
    [ "$n_home" -le 1 ] && [ "$n_swap" -le 1 ] || err="$err\n  at most one /home and one swap"
    if [ -z "$err" ] && ! out=$(table_script | sfdisk --no-act -q "/dev/$DISK" 2>&1); then
        err="$err\n  sfdisk rejects the table:\n$(tail -n 3 <<< "$out" | sed 's/^/    /')"
    fi
    [ -n "$err" ] || return 0
    printf '%b\n' "Problems:$err"
    return 1
}

layout_ask_mount() {   # layout_ask_mount <index>
    local i=$1 j m choices def
    case "${L_KIND[$i]}" in
        esp)   choices="/boot none"; def=/boot ;;
        swap)  choices="swap none"; def=swap ;;
        linux) choices="/ /home none"; def=none
               [[ " ${L_MOUNT[*]} " == *" /home "* ]] || def=/home
               [[ " ${L_MOUNT[*]} " == *" / "* ]] || def=/ ;;
        *)     echo "  this partition type can't be used by cig; delete it and add a new one"; pause; return 0 ;;
    esac
    read -r -p "Mount point ($choices) [$def]: " m
    m=${m:-$def}
    [[ " $choices " == *" $m "* ]] || { echo "  not one of: $choices"; pause; return 0; }
    [ "$m" != none ] || m=""
    if [ -n "$m" ]; then           # one partition per mount point
        for j in "${!L_MOUNT[@]}"; do if [ "${L_MOUNT[$j]}" = "$m" ]; then L_MOUNT[j]=""; fi; done
    fi
    L_MOUNT[i]=$m
    if [ "${L_NEW[$i]}" = no ]; then
        if [ "$m" = / ]; then L_FORMAT[i]=yes; fi
        if [ -z "$m" ]; then L_FORMAT[i]=no; fi    # unused existing partitions are never touched
    fi
}

layout_ask_add() {
    local k
    read -r -p "Type: 1) linux  2) ESP (EFI system)  3) swap [1]: " k
    case "${k:-1}" in 1) k=linux ;; 2) k=esp ;; 3) k=swap ;; *) return 0 ;; esac
    read -r -p "Size (e.g. 512M, 40G, 1T, or rest): " REPLY
    parse_size "$REPLY" || { echo "  not a size"; pause; return 0; }
    layout_new "$k" "$REPLY" ""
    layout_ask_mount $(( ${#L_KIND[@]} - 1 ))
}

ask_part() {   # ask_part <action> -> REPLY = index
    local n
    read -r -p "$1 partition #: " n
    if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#L_KIND[@]} ]; then REPLY=$((n - 1)); return 0; fi
    echo "  no such partition"; pause; return 1
}

layout_edit() {
    local r i
    while :; do
        title "1/6  Disk /dev/$DISK: partitions"
        if [ "$WIPE" = yes ]; then echo "  the whole disk will be erased (new partition table)"; echo; fi
        layout_show
        echo
        echo "  a) add   d) delete   m) mount point   f) format on/off   t) filesystem"
        echo "  e) erase all (start from an empty disk)   r) reload from disk   Enter) done"
        read -r -p "Choice: " r
        case "$r" in
            a) layout_ask_add ;;
            d) if ask_part Delete; then layout_del "$REPLY"; fi ;;
            m) if ask_part "Mount point for"; then layout_ask_mount "$REPLY"; fi ;;
            f) if ask_part "Format"; then
                   i=$REPLY
                   if [ "${L_NEW[$i]}" = yes ]; then echo "  new partitions are always formatted"; pause
                   elif [ -z "${L_MOUNT[$i]}" ]; then echo "  give it a mount point first"; pause
                   elif [ "${L_MOUNT[$i]}" = / ]; then echo "  the system partition is always formatted"; pause
                   elif [ "${L_FORMAT[$i]}" = yes ]; then L_FORMAT[i]=no
                   else L_FORMAT[i]=yes; fi
               fi ;;
            t) if ask_part "Filesystem for"; then
                   i=$REPLY
                   if [ "${L_KIND[$i]}" != linux ] || [ "${L_FORMAT[$i]}" != yes ]; then
                       echo "  only for linux partitions that are formatted"; pause
                   elif [ ${#FS_LINUX[@]} -eq 1 ]; then
                       echo "  only ${FS_LINUX[0]} is available for now"; pause
                   else
                       read -r -p "Filesystem (${FS_LINUX[*]}) [${L_MKFS[$i]}]: " r
                       if [[ " ${FS_LINUX[*]} " == *" ${r:-${L_MKFS[$i]}} "* ]]; then L_MKFS[i]=${r:-${L_MKFS[$i]}}; fi
                   fi
               fi ;;
            e) if yesno "Erase the partition table and start from an empty disk?" n; then
                   layout_clear; disk_geometry; WIPE=yes; HEADER=""
               fi ;;
            r) layout_load ;;
            "") echo; if layout_check; then return 0; fi; pause ;;
        esac
    done
}

screen_disk() {
    local sys n i d size model rm choice
    local -a disks=()
    sys=$(system_disk || true)
    title "1/6  Disk"
    echo "Choose the disk to install on."
    echo
    i=0
    for d in /sys/block/*; do
        n=$(basename "$d")
        case "$n" in loop*|ram*|zram*|sr*|fd*|dm-*|md*) continue ;; esac
        size=$(( $(cat "$d/size") * 512 ))
        [ "$size" -gt 0 ] || continue
        model=$(tr -s ' ' < "$d/device/model" 2>/dev/null || echo "")
        rm=$(cat "$d/removable" 2>/dev/null || echo 0)
        if [ "$n" = "$sys" ]; then
            printf '     %-10s %-9s %s (this system, not available)\n' "$n" "$(size_h "$size")" "$model"
            continue
        fi
        i=$((i + 1)); disks+=("$n")
        printf '  %d) %-10s %-9s %s%s\n' "$i" "$n" "$(size_h "$size")" "$model" "$([ "$rm" = 1 ] && echo ' (removable)')"
    done
    [ ${#disks[@]} -gt 0 ] || { echo; echo "No usable disk found."; pause; return 1; }
    echo
    while :; do
        ask "Disk number" ""
        choice=$REPLY
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#disks[@]} ]; then
            DISK=${disks[$((choice - 1))]}; break
        fi
        echo "  not a valid number"
    done
    echo
    echo "Partitioning:"
    echo "  1) auto:   erase the whole disk, default layout (ESP, system, optional swap and /home)"
    echo "  2) custom: edit the partition table (keep, delete, add partitions)"
    ask "Choice" 1
    if [ "$REPLY" = 2 ]; then
        layout_load
        layout_edit
        return 0
    fi
    size=$(( $(cat "/sys/block/$DISK/size") * 512 >> 30 ))   # GiB
    if yesno "Separate /home partition?" y; then
        SEP_HOME=yes
        ask "Size of the system partition in G (rest goes to /home)" "$ROOT_SIZE"
        ROOT_SIZE=$REPLY
        [[ "$ROOT_SIZE" =~ ^[0-9]+$ ]] && [ "$ROOT_SIZE" -ge 20 ] && [ "$ROOT_SIZE" -lt "$size" ] \
            || { echo "  needs a number between 20 and $((size - 1))"; pause; return 1; }
    else
        SEP_HOME=no
    fi
    ask "Swap partition in G (0 = none; swap is not encrypted)" "$SWAP_SIZE"
    SWAP_SIZE=$REPLY
    [[ "$SWAP_SIZE" =~ ^[0-9]+$ ]] || { echo "  needs a number"; pause; return 1; }
    layout_auto
    layout_check || { pause; return 1; }
}

# ---------------- screen 2: identity ----------------
screen_identity() {
    title "2/6  Name and users"
    ask "Hostname" "$HOSTNAME_"
    [[ "$REPLY" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || { echo "  letters, digits, dashes"; pause; return 1; }
    HOSTNAME_=$REPLY
    ask "Your user name" "$USERNAME"
    [[ "$REPLY" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "  lowercase letters, digits, - and _"; pause; return 1; }
    USERNAME=$REPLY
    ask_secret "Password for $USERNAME"; USERPASS=$REPLY
    echo
    echo "Root account:"
    echo "  1) locked: admin tasks only through doas (recommended)"
    echo "  2) with its own password"
    ask "Choice" "$([ "$ROOTMODE" = lock ] && echo 1 || echo 2)"
    if [ "$REPLY" = 2 ]; then ROOTMODE=password; ask_secret "Root password"; ROOTPASS=$REPLY
    else ROOTMODE=lock; ROOTPASS=""; fi
    echo
    echo "$USERNAME will be in: wheel (doas), audio, video, input, users"
    pause
}

# ---------------- screen 3: components (from recipes) ----------------
load_components() {
    local r n g d desc line
    PKG_NAMES=() PKG_GROUP=() PKG_ON=() PKG_DESC=() BASE_PKGS=""
    while IFS='|' read -r _ g n d desc; do
        PKG_NAMES+=("$n"); PKG_GROUP+=("$g"); PKG_ON+=("${d:-off}"); PKG_DESC+=("$desc")
    done < <(
        for r in "$CIG_SHARE"/packages/*/recipe; do
            n=$(basename "$(dirname "$r")")
            g=$(sed -n 's/^group="\{0,1\}\([a-z-]*\)"\{0,1\}$/\1/p' "$r" | head -n1)
            [ -n "$g" ] && [ "$g" != base ] || continue
            d=$(sed -n 's/^default=\(.*\)$/\1/p' "$r" | head -n1)
            desc=$(sed -n '1s/^# *//p' "$r")
            case "$g" in desktop) o=1 ;; network) o=2 ;; sound) o=3 ;; tools) o=4 ;; build) o=5 ;; *) o=6 ;; esac
            echo "$o|$g|$n|$d|$desc"
        done | sort -t'|' -k1,1n -k3,3
    )
    for r in "$CIG_SHARE"/packages/*/recipe; do
        grep -q '^group="\{0,1\}base"\{0,1\}$' "$r" && BASE_PKGS="$BASE_PKGS $(basename "$(dirname "$r")")"
    done
    return 0
}

screen_components() {
    local i r
    while :; do
        title "3/6  Components"
        echo "Always installed:$BASE_PKGS"
        echo
        local last=""
        for i in "${!PKG_NAMES[@]}"; do
            if [ "${PKG_GROUP[$i]}" != "$last" ]; then echo " ${PKG_GROUP[$i]}:"; last=${PKG_GROUP[$i]}; fi
            printf '  %2d) [%s] %s\n' $((i + 1)) "$([ "${PKG_ON[$i]}" = on ] && echo x || echo ' ')" "${PKG_DESC[$i]}"
        done
        echo " not available yet:"
        echo "      [ ] ALSA sound    [ ] PipeWire    [ ] Bluetooth (BlueZ + D-Bus)    [ ] wmenu"
        echo
        read -r -p "Number to toggle, Enter when done: " r
        [ -n "$r" ] || return 0
        if [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -ge 1 ] && [ "$r" -le ${#PKG_NAMES[@]} ]; then
            i=$((r - 1))
            if [ "${PKG_ON[$i]}" = on ]; then PKG_ON[$i]=off; else PKG_ON[$i]=on; fi
        fi
    done
}

selected_pkgs() {
    local i out="$BASE_PKGS"
    for i in "${!PKG_NAMES[@]}"; do [ "${PKG_ON[$i]}" = on ] && out="$out ${PKG_NAMES[$i]}"; done
    echo $out
}

# ---------------- screen 4: hardware ----------------
detect_hardware() {
    local kdir m f fw
    DRV_NAMES=() DRV_FILES=() DRV_ON=()
    lsmod > "$WORK/lsmod"
    kdir="/usr/lib/modules/$(uname -r)"
    while read -r m; do
        f=$(find "$kdir/" \( -name "$m.ko" -o -name "$(echo "$m" | tr _ -).ko" \) 2>/dev/null | head -n1)
        [ -n "$f" ] || continue
        # most drivers request no firmware: grep then finds nothing, which is fine
        fw=$( { strings "$f" 2>/dev/null || true; } | sed -n 's/^firmware=//p' \
              | { grep -v -E '^(intel-ucode|amd-ucode)/' || true; } | sort -u | tr '\n' ' ')
        [ -n "$fw" ] || continue
        DRV_NAMES+=("$m"); DRV_FILES+=("$fw"); DRV_ON+=(on)
    done < <(awk 'NR > 1 { print $1 }' "$WORK/lsmod")
}

screen_hardware() {
    local i r gpus
    gpus=$(bash -c ". '$CIG_SHARE/lib/hardware.sh'; cig_gpus")
    while :; do
        title "4/6  Hardware"
        echo "Graphics:  ${gpus:-none detected}"
        echo "Network:   $(ls /sys/class/net | grep -v '^lo$' | tr '\n' ' ')"
        echo "Drivers:   $(($(wc -l < "$WORK/lsmod") - 1)) loaded now; the kernel is built with exactly these"
        echo
        echo "Firmware (requested by the drivers above; never CPU microcode):"
        if [ ${#DRV_NAMES[@]} -eq 0 ]; then
            echo "  none needed"
        else
            for i in "${!DRV_NAMES[@]}"; do
                printf '  %2d) [%s] %-16s %d file(s)\n' $((i + 1)) \
                    "$([ "${DRV_ON[$i]}" = on ] && echo x || echo ' ')" "${DRV_NAMES[$i]}" "$(echo ${DRV_FILES[$i]} | wc -w)"
            done
        fi
        echo
        echo "WiFi network (optional, can be set up later): ${WIFI_SSID:-none}"
        echo "   w) set WiFi network"
        echo
        read -r -p "Number to toggle, w for WiFi, Enter when done: " r
        case "$r" in
            "") return 0 ;;
            w)  ask "WiFi name (SSID, empty = none)" "$WIFI_SSID"; WIFI_SSID=$REPLY
                if [ -n "$WIFI_SSID" ]; then ask_secret "WiFi password"; WIFI_PSK=$REPLY; fi ;;
            *)  if [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -ge 1 ] && [ "$r" -le ${#DRV_NAMES[@]} ]; then
                    i=$((r - 1)); if [ "${DRV_ON[$i]}" = on ]; then DRV_ON[$i]=off; else DRV_ON[$i]=on; fi
                fi ;;
        esac
    done
}

# ---------------- screen 5: security (placeholders) ----------------
screen_security() {
    title "5/6  Security layers"
    echo "Always on: signed kernel modules, lockdown, hardened sysctl, noexec /tmp."
    echo
    echo "Optional layers (not available yet, coming in a later version):"
    echo "  [ ] 1  Only packaged programs can run (noexec on all writable places)"
    echo "  [ ] 2  Only software in the inventory starts (services, autostart)"
    echo "  [ ] 3  Kernel-enforced allowlist (IMA appraisal)"
    echo "  [ ] -  Lock kernel module loading after boot"
    echo
    pause
}

# ---------------- screen 6: build mode ----------------
screen_build() {
    title "6/6  Build"
    echo "Packages:"
    echo "  1) compile everything on this machine from verified source (default; hours)"
    echo "  2) use the prebuilt packages from the install media (fast)"
    ask "Choice" "$([ "$BUILD_MODE" = compile ] && echo 1 || echo 2)"
    if [ "$REPLY" = 2 ]; then BUILD_MODE=prebuilt; else BUILD_MODE=compile; fi
    echo
    echo "Kernel:"
    echo "  1) compile for this machine (default, 20-60 min): only the drivers this machine"
    echo "     uses, and a module signing key that exists nowhere else and is deleted after"
    echo "  2) generic kernel from the install media"
    ask "Choice" "$([ "$KERNEL_MODE" = compile ] && echo 1 || echo 2)"
    if [ "$REPLY" = 2 ]; then
        echo
        echo "  WARNING: the generic kernel contains drivers for all common hardware (much"
        echo "  larger attack surface), and its modules were signed with a key that was used"
        echo "  for every copy of the install media, not one unique to this machine."
        if yesno "  Use the generic kernel anyway?" n; then KERNEL_MODE=generic; else KERNEL_MODE=compile; fi
        if [ "$KERNEL_MODE" = generic ] && ! generic_kernel_ok; then KERNEL_MODE=compile; pause; fi
    else
        KERNEL_MODE=compile
    fi
}

kernel_root() {   # kernel_root <linux package> -> the root= in the kernel's built-in command line
    local f
    f=$(tar -tzf "$1" 2>/dev/null | grep '/vmlinuz$' | head -n1 || true)
    [ -n "$f" ] || return 0
    tar -xOzf "$1" "$f" 2>/dev/null | grep -ao 'root=[^ ]*' | head -n1 || true
}

generic_kernel_ok() {   # the media's kernel must find root by name, not by one install's PARTUUID
    local pkg root
    pkg=$("$CIGBUILD" pkgfile linux)
    if [ ! -f "$pkg" ]; then
        echo "  The install media has no prebuilt kernel; it will be compiled."; return 1
    fi
    root=$(kernel_root "$pkg")
    [ "$root" = "root=PARTLABEL=cig-root" ] && return 0
    echo "  The kernel on the install media is not generic: it was built for one"
    echo "  installation (${root:-no root= found}) and would not find this system's root."
    echo "  It will be compiled for this machine instead."
    return 1
}

# ---------------- summary ----------------
summary() {
    local r
    while :; do
        title "Summary"
        printf '  1) Disk:        /dev/%s: %s\n' "$DISK" "$(layout_brief)"
        printf '  2) Identity:    host %s, user %s, root %s\n' "$HOSTNAME_" "$USERNAME" \
            "$([ "$ROOTMODE" = lock ] && echo locked || echo 'with password')"
        printf '  3) Components:  %s\n' "$(selected_pkgs)"
        printf '  4) Hardware:    firmware for %s; WiFi %s\n' \
            "$(for i in "${!DRV_NAMES[@]}"; do [ "${DRV_ON[$i]}" = on ] && printf '%s ' "${DRV_NAMES[$i]}"; done; echo)" \
            "${WIFI_SSID:-not set}"
        printf '  5) Security:    defaults (optional layers not available yet)\n'
        printf '  6) Build:       packages %s, kernel %s\n' "$BUILD_MODE" "$KERNEL_MODE"
        echo
        echo "  i) INSTALL     q) quit without changes"
        echo
        read -r -p "Number to change, i to install: " r
        case "$r" in
            1) screen_disk || true ;;
            2) screen_identity || true ;;
            3) screen_components ;;
            4) screen_hardware ;;
            5) screen_security ;;
            6) screen_build ;;
            q) echo "Nothing was changed."; exit 0 ;;
            i) [ -n "$DISK" ] && [ -n "$USERNAME" ] || { echo "  disk and user are required"; pause; continue; }
               layout_check || { pause; continue; }
               echo
               confirm_text
               read -r -p "Type the disk name ($DISK) to confirm: " r
               [ "$r" = "$DISK" ] && return 0
               echo "  not confirmed"; pause ;;
        esac
    done
}

confirm_text() {   # what will be lost, before typing the disk name
    local i
    if [ "$WIPE" = yes ]; then echo "ALL DATA ON /dev/$DISK WILL BE ERASED."; return; fi
    echo "The partition table of /dev/$DISK will be rewritten."
    for i in "${!ORIG[@]}"; do
        [[ " ${L_NUM[*]} " == *" $i "* ]] || echo "  DELETED (data lost):   ${ORIG[$i]}"
    done
    for i in "${!L_KIND[@]}"; do
        if [ "${L_NEW[$i]}" = no ] && [ "${L_FORMAT[$i]}" = yes ]; then
            echo "  FORMATTED (data lost): ${ORIG[${L_NUM[$i]}]}"
        fi
        if [ "${L_NEW[$i]}" = no ] && [ "${L_FORMAT[$i]}" = no ] && [ -n "${L_MOUNT[$i]}" ]; then
            echo "  kept as ${L_MOUNT[$i]}:        ${ORIG[${L_NUM[$i]}]}"
        fi
        if [ "${L_MOUNT[$i]}" = /boot ] && [ "${L_NEW[$i]}" = no ]; then
            echo "  note: EFI/BOOT/BOOTX64.EFI on the kept ESP will be replaced by cig's kernel"
        fi
    done
}

# ---------------- install ----------------
run()  { echo "+ $*" >> "$LOG"; "$@" >> "$LOG" 2>&1; }
step() { echo "==> $*"; echo "==> $*" >> "$LOG"; }

fs_uuid() { blkid "$1" | sed -n 's/.* UUID="\([^"]*\)".*/\1/p'; }

make_fs() {   # make_fs <filesystem> <device> <mount point>
    local label
    case "$3" in /) label=root ;; /home) label=home ;; /boot) label=ESP ;; swap) label=swap ;; *) label=data ;; esac
    case "$1" in
        vfat) run mkfs.vfat -F 32 -n "$label" "$2" ;;
        ext4) run mkfs.ext4 -F -q -L "$label" "$2" ;;
        swap) run mkswap -L "$label" "$2" ;;
        *)    echo "no mkfs for $1" >> "$LOG"; false ;;
    esac
}

part() { case "$DISK" in *[0-9]) echo "/dev/${DISK}p$1" ;; *) echo "/dev/$DISK$1" ;; esac; }

cleanup_mounts() {
    local m
    for m in dev/pts dev proc sys run boot home ""; do
        grep -q " $T${m:+/$m} " /proc/mounts 2>/dev/null && umount "$T${m:+/$m}" 2>/dev/null || true
    done
}

on_error() {
    echo
    echo "!! installation failed. Last lines of $LOG:"
    tail -n 20 "$LOG" 2>/dev/null || true
    cleanup_mounts
}

do_install() {
    local p n id fwlist pkgs
    : > "$LOG"
    trap on_error ERR
    pkgs=$(selected_pkgs)

    step "Partitioning /dev/$DISK"
    cleanup_mounts
    if grep -q "^/dev/$DISK" /proc/mounts; then
        echo "/dev/$DISK is mounted:" >> "$LOG"; grep "^/dev/$DISK" /proc/mounts >> "$LOG"
        echo "    /dev/$DISK has mounted partitions (see log); unmount them first"; false
    fi
    layout_place
    table_script > "$WORK/layout"
    cat "$WORK/layout" >> "$LOG"
    if [ "$WIPE" = yes ]; then
        run sfdisk --wipe always --wipe-partitions always "/dev/$DISK" < "$WORK/layout"
    else   # kept partitions must not be wiped; new ones are formatted below anyway
        run sfdisk --wipe never --wipe-partitions never "/dev/$DISK" < "$WORK/layout"
    fi
    sleep 2; mdev -s 2>/dev/null || true

    step "Formatting"
    local i dev DEV_ESP="" DEV_ROOT="" DEV_HOME="" DEV_SWAP="" N_ROOT="" FS_ROOT="" FS_HOME=""
    for i in "${!L_KIND[@]}"; do
        dev=$(part "${P_NUM[$i]}")
        case "${L_MOUNT[$i]}" in
            /)     DEV_ROOT=$dev; N_ROOT=${P_NUM[$i]}; FS_ROOT=$(eff_fs "$i") ;;
            /home) DEV_HOME=$dev; FS_HOME=$(eff_fs "$i") ;;
            /boot) DEV_ESP=$dev ;;
            swap)  DEV_SWAP=$dev ;;
        esac
        if [ "${L_FORMAT[$i]}" = yes ]; then make_fs "${L_MKFS[$i]}" "$dev" "${L_MOUNT[$i]}"; fi
    done

    # unique IDs: labels are not unique when several cig disks are attached
    local U_ESP U_ROOT U_HOME="" U_SWAP="" PU_ROOT
    U_ESP=$(fs_uuid "$DEV_ESP"); U_ROOT=$(fs_uuid "$DEV_ROOT")
    if [ -n "$DEV_HOME" ]; then U_HOME=$(fs_uuid "$DEV_HOME"); fi
    if [ -n "$DEV_SWAP" ]; then U_SWAP=$(fs_uuid "$DEV_SWAP"); fi
    PU_ROOT=$(sfdisk --part-uuid "/dev/$DISK" "$N_ROOT")
    echo "+ ids: esp=$U_ESP root=$U_ROOT home=$U_HOME swap=$U_SWAP root-partuuid=$PU_ROOT" >> "$LOG"
    [ -n "$U_ESP" ] && [ -n "$U_ROOT" ] && [ -n "$PU_ROOT" ] || { echo "could not read partition IDs" >> "$LOG"; false; }
    if [ -n "$DEV_HOME" ] && [ -z "$U_HOME" ]; then echo "could not read the /home UUID" >> "$LOG"; false; fi
    if [ -n "$DEV_SWAP" ] && [ -z "$U_SWAP" ]; then echo "could not read the swap UUID" >> "$LOG"; false; fi

    step "Mounting"
    mkdir -p "$T"
    run mount -t "$FS_ROOT" "$DEV_ROOT" "$T"
    mkdir -p "$T/boot" "$T/home"
    run mount -t vfat "$DEV_ESP" "$T/boot"
    if [ -n "$DEV_HOME" ]; then run mount -t "$FS_HOME" "$DEV_HOME" "$T/home"; fi

    step "Base layout"
    mkdir -p "$T"/{usr/bin,usr/lib,usr/sbin,etc/cig,var/log,var/tmp,dev,proc,sys,run,tmp,root}
    ln -s usr/bin "$T/bin"; ln -s usr/lib "$T/lib"; ln -s usr/sbin "$T/sbin"
    chmod 1777 "$T/tmp" "$T/var/tmp"; chmod 0750 "$T/root"
    cat > "$T/etc/passwd" <<'EOF'
root:x:0:0:root:/root:/bin/bash
nobody:x:65534:65534:nobody:/:/bin/false
EOF
    cat > "$T/etc/group" <<'EOF'
root:x:0:
tty:x:5:
wheel:x:10:
audio:x:11:
video:x:12:
input:x:24:
users:x:100:
nogroup:x:65534:
EOF
    printf 'root:!:20000:0:99999:7:::\nnobody:!:20000:0:99999:7:::\n' > "$T/etc/shadow"
    chmod 600 "$T/etc/shadow"
    echo "$HOSTNAME_" > "$T/etc/hostname"
    printf '127.0.0.1 localhost %s\n::1       localhost %s\n' "$HOSTNAME_" "$HOSTNAME_" > "$T/etc/hosts"
    : > "$T/etc/resolv.conf"
    {
        echo "# device                                   mount  type   options                                dump pass"
        printf '%-42s %-6s %-6s %-38s 0    1\n' "UUID=$U_ROOT" / "$FS_ROOT" defaults,noatime
        if [ -n "$DEV_HOME" ]; then
            printf '%-42s %-6s %-6s %-38s 0    2\n' "UUID=$U_HOME" /home "$FS_HOME" defaults,noatime,nodev,nosuid
        fi
        echo "UUID=$U_ESP                             /boot  vfat   noauto,nodev,nosuid,noexec,umask=0077  0    0"
        if [ -n "$DEV_SWAP" ]; then
            printf '%-42s %-6s %-6s %-38s 0    0\n' "UUID=$U_SWAP" none swap sw
        fi
        echo "tmpfs                                      /tmp   tmpfs  nosuid,nodev,noexec,mode=1777          0    0"
    } > "$T/etc/fstab"
    touch "$T/etc/cig/efi-fallback"     # no boot entries yet: boot via EFI/BOOT/BOOTX64.EFI

    # hardware choices for the builds below
    cp "$WORK/lsmod" "$T/etc/cig/lsmod.install"
    fwlist="$T/etc/cig/firmware.list"
    : > "$fwlist"
    for i in "${!DRV_NAMES[@]}"; do
        [ "${DRV_ON[$i]}" = on ] && printf '%s\n' ${DRV_FILES[$i]} >> "$fwlist"
    done
    sort -u -o "$fwlist" "$fwlist"

    # Everything is built on the target disk, in the new system's own /var/cig:
    # the sources (and packages) stay there for later "smoke add -c".
    local MEDIA_VAR="$CIG_VAR"
    export CIG_VAR="$T/var/cig"
    mkdir -p "$CIG_VAR"/{sources,pkgs,build,logs}
    step "Copying sources to the new system"
    cp -a "$MEDIA_VAR/sources/." "$CIG_VAR/sources/"
    step "Preparing packages ($BUILD_MODE)"
    if [ "$BUILD_MODE" = prebuilt ]; then
        cp -a "$MEDIA_VAR/pkgs/." "$CIG_VAR/pkgs/"
    fi
    if [ "$KERNEL_MODE" = generic ]; then
        cp -a "$(CIG_VAR="$MEDIA_VAR" "$CIGBUILD" pkgfile linux)" "$CIG_VAR/pkgs/"
    fi
    # kernel and firmware are always made for this machine's selection
    if [ "$KERNEL_MODE" = compile ]; then
        rm -f "$("$CIGBUILD" pkgfile linux)"
        step "Compiling the kernel for this machine (this takes a while; log: $CIG_VAR/logs/linux.log)"
        run env CIG_KERNEL_PROFILE=local CIG_KERNEL_LSMOD="$WORK/lsmod" CIG_ROOT="PARTUUID=$PU_ROOT" \
            "$CIGBUILD" build linux
    fi
    rm -f "$("$CIGBUILD" pkgfile linux-firmware)"
    step "Selecting firmware ($(wc -l < "$fwlist") file(s))"
    run env CIG_FIRMWARE_LIST="$fwlist" "$CIGBUILD" build linux-firmware

    step "Installing packages"
    export SMOKE_ROOT="$T"
    for p in $pkgs; do
        echo "    $p"
        case "$p:$BUILD_MODE:$KERNEL_MODE" in
            linux:*:*|linux-firmware:*:*) run "$SMOKE" add -p -y "$p" ;;   # built above for this machine
            *:compile:*)                  run "$SMOKE" add -c -y "$p" ;;
            *)                            run "$SMOKE" add -p -y "$p" ;;
        esac
    done
    unset SMOKE_ROOT

    # prebuilt build tools stay available (not installed): the first "smoke add -c"
    # on the new system can then offer them without compiling a compiler first
    step "Keeping prebuilt build tools available"
    cp -an "$MEDIA_VAR/pkgs/." "$CIG_VAR/pkgs/" 2>/dev/null || true
    rm -rf "$CIG_VAR/build"/*

    step "Running package setup inside the new system"
    mount --bind /dev "$T/dev"; mount -t devpts devpts "$T/dev/pts" 2>/dev/null || true
    mount -t proc proc "$T/proc"; mount -t sysfs sysfs "$T/sys"; mount -t tmpfs tmpfs "$T/run"
    run env SMOKE_ROOT="$T" "$SMOKE" hooks --all || echo "    ! some package setup failed (see $LOG)"

    step "Users"
    run chroot "$T" adduser -D -s /bin/bash -h "/home/$USERNAME" "$USERNAME"
    for g in wheel audio video input users; do run chroot "$T" addgroup "$USERNAME" "$g"; done
    printf '%s:%s\n' "$USERNAME" "$USERPASS" | chroot "$T" chpasswd -c sha512 >> "$LOG" 2>&1
    if [ "$ROOTMODE" = password ]; then
        printf 'root:%s\n' "$ROOTPASS" | chroot "$T" chpasswd -c sha512 >> "$LOG" 2>&1
    fi
    chown -R "$(chroot "$T" id -u "$USERNAME"):$(chroot "$T" id -g "$USERNAME")" "$T/home/$USERNAME"
    chmod 700 "$T/home/$USERNAME"

    step "Network"
    mkdir -p "$T/etc/service"
    if [ -d /sys/class/net/eth0 ] && [ -d "$T/etc/sv/udhcpc-eth0" ]; then
        ln -sfn /etc/sv/udhcpc-eth0 "$T/etc/service/udhcpc-eth0"
    fi
    if [ -d /sys/class/net/wlan0 ] && [ -x "$T/usr/sbin/wpa_supplicant" ]; then
        ln -sfn /etc/sv/wpa_supplicant "$T/etc/service/wpa_supplicant"
        ln -sfn /etc/sv/udhcpc-wlan0 "$T/etc/service/udhcpc-wlan0"
        if [ -n "$WIFI_SSID" ]; then
            chroot "$T" wpa_passphrase "$WIFI_SSID" "$WIFI_PSK" | grep -v '#psk=' \
                >> "$T/etc/wpa_supplicant/wpa_supplicant.conf"
        fi
    fi

    step "Finishing"
    cp "$LOG" "$T/var/log/cig-install.log"; chmod 600 "$T/var/log/cig-install.log"
    sync
    trap - ERR
    cleanup_mounts
    echo
    hr
    echo "cig $VERSION is installed on /dev/$DISK."
    echo "Power off, remove the install media, and boot from that disk."
    hr
}

# ---------------- main ----------------
# never stop silently: report where it happened
trap 'echo; echo "!! cig-install stopped unexpectedly at line $LINENO (please report this line)"' ERR
preflight
load_components
detect_hardware
title "Welcome"
echo "This installs cig $VERSION. You can review everything before anything is written."
echo
pause
until screen_disk; do :; done
until screen_identity; do :; done
screen_components
screen_hardware
screen_security
screen_build
summary
do_install
