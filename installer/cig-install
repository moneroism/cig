#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 moneroism
#
# cig-install - install cig onto a disk. Run as root on a running cig system
# (the install media, or for testing a VM with a second, empty disk).
#
# Menus are numbered; checklists toggle with the item number. Nothing is
# written to any disk before the final confirmation.

set -euo pipefail
umask 022

CIG_SHARE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"   # cigbuild, smoke, packages
VERSION=$(cat "$CIG_SHARE/VERSION" 2>/dev/null || echo unknown)
CIGBUILD="$CIG_SHARE/cigbuild"
SMOKE="$CIG_SHARE/smoke"
T=/mnt/cig-target
LOG=/var/log/cig-install.log
WORK=/tmp/cig-install
export CIG_VAR="${CIG_VAR:-/var/cig}"

# ---------------- choices (filled by the screens) ----------------
DISK="" ROOT_SIZE="40" SEP_HOME=yes
HOSTNAME_="cig" USERNAME="" USERPASS="" ROOTMODE=lock ROOTPASS=""
BUILD_MODE=prebuilt KERNEL_MODE=compile
WIFI_SSID="" WIFI_PSK=""
declare -a PKG_NAMES=() PKG_GROUP=() PKG_ON=() PKG_DESC=()
declare -a DRV_NAMES=() DRV_FILES=() DRV_ON=()
BASE_PKGS=""

# ---------------- UI helpers ----------------
hr()    { printf '%s\n' "------------------------------------------------------------"; }
title() { clear 2>/dev/null || true; echo "cig $VERSION installer"; hr; echo "$*"; hr; }
die()   { echo; echo "!! $*" >&2; exit 1; }
pause() { read -r -p "Press Enter to continue " _; }

ask() {   # ask <prompt> <default> -> REPLY
    local d=$2
    read -r -p "$1${d:+ [$d]}: " REPLY
    [ -n "$REPLY" ] || REPLY=$d
}

ask_secret() {   # ask_secret <prompt> -> REPLY (asked twice)
    local a b
    while :; do
        read -r -s -p "$1: " a; echo
        [ -n "$a" ] || { echo "  empty, try again"; continue; }
        read -r -s -p "repeat: " b; echo
        [ "$a" = "$b" ] && { REPLY=$a; return; }
        echo "  did not match, try again"
    done
}

yesno() {   # yesno <prompt> <default y|n>
    local r
    read -r -p "$1 [$( [ "$2" = y ] && echo Y/n || echo y/N )]: " r
    r=${r:-$2}
    case "$r" in y|Y|yes) return 0 ;; *) return 1 ;; esac
}

# ---------------- checks ----------------
preflight() {
    [ "$(id -u)" -eq 0 ] || die "run as root"
    [ -d /sys/firmware/efi ] || die "this machine did not boot in UEFI mode; cig needs UEFI"
    local c
    for c in sfdisk mkfs.vfat mkfs.ext4 mountpoint chpasswd adduser; do
        command -v "$c" >/dev/null || die "missing tool: $c"
    done
    [ -x "$CIGBUILD" ] && [ -x "$SMOKE" ] || die "cigbuild/smoke not found next to the installer"
    mkdir -p "$WORK"
}

# ---------------- screen 1: disk ----------------
size_h() { awk -v b="$1" 'BEGIN { if (b >= 1e12) printf "%.1f TB", b/1e12; else printf "%.0f GB", b/1e9 }'; }

system_disk() {   # the disk this system runs from (never offered)
    local mm d p
    mm=$(mountpoint -d /)
    for p in /sys/class/block/*; do
        [ "$(cat "$p/dev" 2>/dev/null)" = "$mm" ] || continue
        if [ -f "$p/partition" ]; then d=$(basename "$(readlink -f "$p/..")"); else d=$(basename "$p"); fi
        echo "$d"; return
    done
}

screen_disk() {
    local sys n i d size model rm choice
    local -a disks=()
    sys=$(system_disk || true)
    title "1/6  Disk"
    echo "Choose the disk to install on. EVERYTHING on it will be erased."
    echo
    i=0
    for d in /sys/block/*; do
        n=$(basename "$d")
        case "$n" in loop*|ram*|zram*|sr*|fd*|dm-*|md*) continue ;; esac
        size=$(( $(cat "$d/size") * 512 ))
        [ "$size" -gt 0 ] || continue
        model=$(tr -s ' ' < "$d/device/model" 2>/dev/null || echo "")
        rm=$(cat "$d/removable" 2>/dev/null || echo 0)
        if [ "$n" = "$sys" ]; then
            printf '     %-10s %-9s %s (this system, not available)\n' "$n" "$(size_h "$size")" "$model"
            continue
        fi
        i=$((i + 1)); disks+=("$n")
        printf '  %d) %-10s %-9s %s%s\n' "$i" "$n" "$(size_h "$size")" "$model" "$([ "$rm" = 1 ] && echo ' (removable)')"
    done
    [ ${#disks[@]} -gt 0 ] || { echo; echo "No usable disk found."; pause; return 1; }
    echo
    while :; do
        ask "Disk number" ""
        choice=$REPLY
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#disks[@]} ]; then
            DISK=${disks[$((choice - 1))]}; break
        fi
        echo "  not a valid number"
    done
    echo
    size=$(( $(cat "/sys/block/$DISK/size") * 512 / 1000000000 ))
    if yesno "Separate /home partition?" y; then
        SEP_HOME=yes
        ask "Size of the system partition in GB (rest goes to /home)" "$ROOT_SIZE"
        ROOT_SIZE=$REPLY
        [[ "$ROOT_SIZE" =~ ^[0-9]+$ ]] && [ "$ROOT_SIZE" -ge 20 ] && [ "$ROOT_SIZE" -lt "$size" ] \
            || { echo "  needs a number between 20 and $((size - 1))"; pause; return 1; }
    else
        SEP_HOME=no
    fi
}

# ---------------- screen 2: identity ----------------
screen_identity() {
    title "2/6  Name and users"
    ask "Hostname" "$HOSTNAME_"
    [[ "$REPLY" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || { echo "  letters, digits, dashes"; pause; return 1; }
    HOSTNAME_=$REPLY
    ask "Your user name" "$USERNAME"
    [[ "$REPLY" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "  lowercase letters, digits, - and _"; pause; return 1; }
    USERNAME=$REPLY
    ask_secret "Password for $USERNAME"; USERPASS=$REPLY
    echo
    echo "Root account:"
    echo "  1) locked: admin tasks only through doas (recommended)"
    echo "  2) with its own password"
    ask "Choice" "$([ "$ROOTMODE" = lock ] && echo 1 || echo 2)"
    if [ "$REPLY" = 2 ]; then ROOTMODE=password; ask_secret "Root password"; ROOTPASS=$REPLY
    else ROOTMODE=lock; ROOTPASS=""; fi
    echo
    echo "$USERNAME will be in: wheel (doas), audio, video, input, users"
    pause
}

# ---------------- screen 3: components (from recipes) ----------------
load_components() {
    local r n g d desc line
    PKG_NAMES=() PKG_GROUP=() PKG_ON=() PKG_DESC=() BASE_PKGS=""
    while IFS='|' read -r _ g n d desc; do
        PKG_NAMES+=("$n"); PKG_GROUP+=("$g"); PKG_ON+=("${d:-off}"); PKG_DESC+=("$desc")
    done < <(
        for r in "$CIG_SHARE"/packages/*/recipe; do
            n=$(basename "$(dirname "$r")")
            g=$(sed -n 's/^group="\{0,1\}\([a-z-]*\)"\{0,1\}$/\1/p' "$r" | head -n1)
            [ -n "$g" ] && [ "$g" != base ] || continue
            d=$(sed -n 's/^default=\(.*\)$/\1/p' "$r" | head -n1)
            desc=$(sed -n '1s/^# *//p' "$r")
            case "$g" in desktop) o=1 ;; network) o=2 ;; sound) o=3 ;; tools) o=4 ;; build) o=5 ;; *) o=6 ;; esac
            echo "$o|$g|$n|$d|$desc"
        done | sort -t'|' -k1,1n -k3,3
    )
    for r in "$CIG_SHARE"/packages/*/recipe; do
        grep -q '^group="\{0,1\}base"\{0,1\}$' "$r" && BASE_PKGS="$BASE_PKGS $(basename "$(dirname "$r")")"
    done
    return 0
}

screen_components() {
    local i r
    while :; do
        title "3/6  Components"
        echo "Always installed:$BASE_PKGS"
        echo
        local last=""
        for i in "${!PKG_NAMES[@]}"; do
            if [ "${PKG_GROUP[$i]}" != "$last" ]; then echo " ${PKG_GROUP[$i]}:"; last=${PKG_GROUP[$i]}; fi
            printf '  %2d) [%s] %s\n' $((i + 1)) "$([ "${PKG_ON[$i]}" = on ] && echo x || echo ' ')" "${PKG_DESC[$i]}"
        done
        echo " not available yet:"
        echo "      [ ] ALSA sound    [ ] PipeWire    [ ] Bluetooth (BlueZ + D-Bus)    [ ] wmenu"
        echo
        read -r -p "Number to toggle, Enter when done: " r
        [ -n "$r" ] || return 0
        if [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -ge 1 ] && [ "$r" -le ${#PKG_NAMES[@]} ]; then
            i=$((r - 1))
            if [ "${PKG_ON[$i]}" = on ]; then PKG_ON[$i]=off; else PKG_ON[$i]=on; fi
        fi
    done
}

selected_pkgs() {
    local i out="$BASE_PKGS"
    for i in "${!PKG_NAMES[@]}"; do [ "${PKG_ON[$i]}" = on ] && out="$out ${PKG_NAMES[$i]}"; done
    echo $out
}

# ---------------- screen 4: hardware ----------------
detect_hardware() {
    local kdir m f fw
    DRV_NAMES=() DRV_FILES=() DRV_ON=()
    lsmod > "$WORK/lsmod"
    kdir="/usr/lib/modules/$(uname -r)"
    while read -r m; do
        f=$(find "$kdir/" \( -name "$m.ko" -o -name "$(echo "$m" | tr _ -).ko" \) 2>/dev/null | head -n1)
        [ -n "$f" ] || continue
        fw=$(strings "$f" | sed -n 's/^firmware=//p' | grep -v -E '^(intel-ucode|amd-ucode)/' | sort -u | tr '\n' ' ')
        [ -n "$fw" ] || continue
        DRV_NAMES+=("$m"); DRV_FILES+=("$fw"); DRV_ON+=(on)
    done < <(awk 'NR > 1 { print $1 }' "$WORK/lsmod")
}

screen_hardware() {
    local i r gpus
    gpus=$(bash -c ". '$CIG_SHARE/lib/hardware.sh'; cig_gpus")
    while :; do
        title "4/6  Hardware"
        echo "Graphics:  ${gpus:-none detected}"
        echo "Network:   $(ls /sys/class/net | grep -v '^lo$' | tr '\n' ' ')"
        echo "Drivers:   $(($(wc -l < "$WORK/lsmod") - 1)) loaded now; the kernel is built with exactly these"
        echo
        echo "Firmware (requested by the drivers above; never CPU microcode):"
        if [ ${#DRV_NAMES[@]} -eq 0 ]; then
            echo "  none needed"
        else
            for i in "${!DRV_NAMES[@]}"; do
                printf '  %2d) [%s] %-16s %d file(s)\n' $((i + 1)) \
                    "$([ "${DRV_ON[$i]}" = on ] && echo x || echo ' ')" "${DRV_NAMES[$i]}" "$(echo ${DRV_FILES[$i]} | wc -w)"
            done
        fi
        echo
        echo "WiFi network (optional, can be set up later): ${WIFI_SSID:-none}"
        echo "   w) set WiFi network"
        echo
        read -r -p "Number to toggle, w for WiFi, Enter when done: " r
        case "$r" in
            "") return 0 ;;
            w)  ask "WiFi name (SSID, empty = none)" "$WIFI_SSID"; WIFI_SSID=$REPLY
                if [ -n "$WIFI_SSID" ]; then ask_secret "WiFi password"; WIFI_PSK=$REPLY; fi ;;
            *)  if [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -ge 1 ] && [ "$r" -le ${#DRV_NAMES[@]} ]; then
                    i=$((r - 1)); if [ "${DRV_ON[$i]}" = on ]; then DRV_ON[$i]=off; else DRV_ON[$i]=on; fi
                fi ;;
        esac
    done
}

# ---------------- screen 5: security (placeholders) ----------------
screen_security() {
    title "5/6  Security layers"
    echo "Always on: signed kernel modules, lockdown, hardened sysctl, noexec /tmp."
    echo
    echo "Optional layers (not available yet, coming in a later version):"
    echo "  [ ] 1  Only packaged programs can run (noexec on all writable places)"
    echo "  [ ] 2  Only software in the inventory starts (services, autostart)"
    echo "  [ ] 3  Kernel-enforced allowlist (IMA appraisal)"
    echo "  [ ] -  Lock kernel module loading after boot"
    echo
    pause
}

# ---------------- screen 6: build mode ----------------
screen_build() {
    title "6/6  Build"
    echo "Packages:"
    echo "  1) compile everything on this machine from verified source (hours)"
    echo "  2) use the prebuilt, verified packages from the install media (fast)"
    ask "Choice" "$([ "$BUILD_MODE" = compile ] && echo 1 || echo 2)"
    if [ "$REPLY" = 1 ]; then BUILD_MODE=compile; else BUILD_MODE=prebuilt; fi
    echo
    echo "Kernel:"
    echo "  1) compile for this machine, with its own module signing key (recommended, 20-60 min)"
    echo "  2) reuse the kernel package on the install media (key not unique)"
    ask "Choice" "$([ "$KERNEL_MODE" = compile ] && echo 1 || echo 2)"
    if [ "$REPLY" = 2 ]; then KERNEL_MODE=reuse; else KERNEL_MODE=compile; fi
}

# ---------------- summary ----------------
summary() {
    local r
    while :; do
        title "Summary"
        printf '  1) Disk:        /dev/%s  (%s)\n' "$DISK" \
            "$([ "$SEP_HOME" = yes ] && echo "ESP 512 MB, system ${ROOT_SIZE} GB, /home rest" || echo "ESP 512 MB, system rest")"
        printf '  2) Identity:    host %s, user %s, root %s\n' "$HOSTNAME_" "$USERNAME" \
            "$([ "$ROOTMODE" = lock ] && echo locked || echo 'with password')"
        printf '  3) Components:  %s\n' "$(selected_pkgs)"
        printf '  4) Hardware:    firmware for %s; WiFi %s\n' \
            "$(for i in "${!DRV_NAMES[@]}"; do [ "${DRV_ON[$i]}" = on ] && printf '%s ' "${DRV_NAMES[$i]}"; done; echo)" \
            "${WIFI_SSID:-not set}"
        printf '  5) Security:    defaults (optional layers not available yet)\n'
        printf '  6) Build:       packages %s, kernel %s\n' "$BUILD_MODE" "$KERNEL_MODE"
        echo
        echo "  i) INSTALL     q) quit without changes"
        echo
        read -r -p "Number to change, i to install: " r
        case "$r" in
            1) screen_disk || true ;;
            2) screen_identity || true ;;
            3) screen_components ;;
            4) screen_hardware ;;
            5) screen_security ;;
            6) screen_build ;;
            q) echo "Nothing was changed."; exit 0 ;;
            i) [ -n "$DISK" ] && [ -n "$USERNAME" ] || { echo "  disk and user are required"; pause; continue; }
               echo
               echo "ALL DATA ON /dev/$DISK WILL BE ERASED."
               read -r -p "Type the disk name ($DISK) to confirm: " r
               [ "$r" = "$DISK" ] && return 0
               echo "  not confirmed"; pause ;;
        esac
    done
}

# ---------------- install ----------------
run()  { echo "+ $*" >> "$LOG"; "$@" >> "$LOG" 2>&1; }
step() { echo "==> $*"; echo "==> $*" >> "$LOG"; }

part() { case "$DISK" in *[0-9]) echo "/dev/${DISK}p$1" ;; *) echo "/dev/$DISK$1" ;; esac; }

cleanup_mounts() {
    local m
    for m in dev/pts dev proc sys run boot home ""; do
        grep -q " $T${m:+/$m} " /proc/mounts 2>/dev/null && umount "$T${m:+/$m}" 2>/dev/null || true
    done
}

on_error() {
    echo
    echo "!! installation failed. Last lines of $LOG:"
    tail -n 20 "$LOG" 2>/dev/null || true
    cleanup_mounts
}

do_install() {
    local p n id fwlist pkgs
    : > "$LOG"
    trap on_error ERR
    pkgs=$(selected_pkgs)

    step "Partitioning /dev/$DISK"
    cleanup_mounts
    {
        echo "label: gpt"
        echo 'size=512MiB, type=uefi, name="ESP"'
        if [ "$SEP_HOME" = yes ]; then
            echo "size=${ROOT_SIZE}GiB, type=linux, name=\"cig-root\""
            echo 'type=linux, name="cig-home"'
        else
            echo 'type=linux, name="cig-root"'
        fi
    } > "$WORK/layout"
    run sfdisk --wipe always --wipe-partitions always "/dev/$DISK" < "$WORK/layout"
    sleep 2; mdev -s 2>/dev/null || true

    step "Formatting"
    run mkfs.vfat -F 32 -n ESP "$(part 1)"
    run mkfs.ext4 -F -q -L root "$(part 2)"
    [ "$SEP_HOME" = yes ] && run mkfs.ext4 -F -q -L home "$(part 3)"

    step "Mounting"
    mkdir -p "$T"
    run mount -t ext4 "$(part 2)" "$T"
    mkdir -p "$T/boot" "$T/home"
    run mount -t vfat "$(part 1)" "$T/boot"
    [ "$SEP_HOME" = yes ] && run mount -t ext4 "$(part 3)" "$T/home"

    step "Base layout"
    mkdir -p "$T"/{usr/bin,usr/lib,usr/sbin,etc/cig,var/log,var/tmp,dev,proc,sys,run,tmp,root}
    ln -s usr/bin "$T/bin"; ln -s usr/lib "$T/lib"; ln -s usr/sbin "$T/sbin"
    chmod 1777 "$T/tmp" "$T/var/tmp"; chmod 0750 "$T/root"
    cat > "$T/etc/passwd" <<'EOF'
root:x:0:0:root:/root:/bin/bash
nobody:x:65534:65534:nobody:/:/bin/false
EOF
    cat > "$T/etc/group" <<'EOF'
root:x:0:
tty:x:5:
wheel:x:10:
audio:x:11:
video:x:12:
input:x:24:
users:x:100:
nogroup:x:65534:
EOF
    printf 'root:!:20000:0:99999:7:::\nnobody:!:20000:0:99999:7:::\n' > "$T/etc/shadow"
    chmod 600 "$T/etc/shadow"
    echo "$HOSTNAME_" > "$T/etc/hostname"
    printf '127.0.0.1 localhost %s\n::1       localhost %s\n' "$HOSTNAME_" "$HOSTNAME_" > "$T/etc/hosts"
    : > "$T/etc/resolv.conf"
    {
        echo "# device      mount  type   options                                  dump pass"
        echo "LABEL=root    /      ext4   defaults,noatime                         0    1"
        [ "$SEP_HOME" = yes ] && echo "LABEL=home    /home  ext4   defaults,noatime,nodev,nosuid            0    2"
        echo "LABEL=ESP     /boot  vfat   noauto,nodev,nosuid,noexec,umask=0077    0    0"
        echo "tmpfs         /tmp   tmpfs  nosuid,nodev,noexec,mode=1777            0    0"
    } > "$T/etc/fstab"
    touch "$T/etc/cig/efi-fallback"     # no boot entries yet: boot via EFI/BOOT/BOOTX64.EFI

    # hardware choices for the builds below
    cp "$WORK/lsmod" "$T/etc/cig/lsmod.install"
    fwlist="$T/etc/cig/firmware.list"
    : > "$fwlist"
    for i in "${!DRV_NAMES[@]}"; do
        [ "${DRV_ON[$i]}" = on ] && printf '%s\n' ${DRV_FILES[$i]} >> "$fwlist"
    done
    sort -u -o "$fwlist" "$fwlist"

    step "Preparing packages ($BUILD_MODE)"
    if [ "$BUILD_MODE" = compile ]; then
        for p in $(ls "$CIG_VAR/pkgs/" 2>/dev/null | grep '\.tar\.gz$' || true); do
            rm -f "$CIG_VAR/pkgs/$p" "$CIG_VAR/pkgs/$p.sha256"
        done
    fi
    # kernel and firmware are always made for this machine's selection
    if [ "$KERNEL_MODE" = compile ]; then
        rm -f "$("$CIGBUILD" pkgfile linux)"
        step "Compiling the kernel for this machine (this takes a while; log: $CIG_VAR/logs/linux.log)"
        run env CIG_KERNEL_PROFILE=local CIG_KERNEL_LSMOD="$WORK/lsmod" "$CIGBUILD" build linux
    fi
    rm -f "$("$CIGBUILD" pkgfile linux-firmware)"
    step "Selecting firmware ($(wc -l < "$fwlist") file(s))"
    run env CIG_FIRMWARE_LIST="$fwlist" "$CIGBUILD" build linux-firmware

    step "Installing packages"
    export SMOKE_ROOT="$T"
    for p in $pkgs; do
        echo "    $p"
        run "$SMOKE" install "$p"
    done
    unset SMOKE_ROOT

    step "Running package setup inside the new system"
    mount --bind /dev "$T/dev"; mount -t devpts devpts "$T/dev/pts" 2>/dev/null || true
    mount -t proc proc "$T/proc"; mount -t sysfs sysfs "$T/sys"; mount -t tmpfs tmpfs "$T/run"
    # busybox first: its hook creates the command links the other hooks use
    for n in busybox $(grep -v '^#' "$T/usr/pkg/INVENTORY" | awk '$1 != "busybox" { print $1 }'); do
        id=$(awk -v n="$n" '$1 == n { print $6 }' "$T/usr/pkg/INVENTORY")
        [ -f "$T/usr/pkg/$n/$id/.meta/INSTALL" ] || continue
        run chroot "$T" /bin/bash -c ". /usr/pkg/$n/$id/.meta/INSTALL; post_install" || echo "    ! $n setup failed (see log)"
    done

    step "Users"
    run chroot "$T" adduser -D -s /bin/bash -h "/home/$USERNAME" "$USERNAME"
    for g in wheel audio video input users; do run chroot "$T" addgroup "$USERNAME" "$g"; done
    printf '%s:%s\n' "$USERNAME" "$USERPASS" | chroot "$T" chpasswd -c sha512 >> "$LOG" 2>&1
    if [ "$ROOTMODE" = password ]; then
        printf 'root:%s\n' "$ROOTPASS" | chroot "$T" chpasswd -c sha512 >> "$LOG" 2>&1
    fi
    chown -R "$(chroot "$T" id -u "$USERNAME"):$(chroot "$T" id -g "$USERNAME")" "$T/home/$USERNAME"
    chmod 700 "$T/home/$USERNAME"

    step "Network"
    mkdir -p "$T/etc/service"
    if [ -d /sys/class/net/eth0 ] && [ -d "$T/etc/sv/udhcpc-eth0" ]; then
        ln -sfn /etc/sv/udhcpc-eth0 "$T/etc/service/udhcpc-eth0"
    fi
    if [ -d /sys/class/net/wlan0 ] && [ -x "$T/usr/sbin/wpa_supplicant" ]; then
        ln -sfn /etc/sv/wpa_supplicant "$T/etc/service/wpa_supplicant"
        ln -sfn /etc/sv/udhcpc-wlan0 "$T/etc/service/udhcpc-wlan0"
        if [ -n "$WIFI_SSID" ]; then
            chroot "$T" wpa_passphrase "$WIFI_SSID" "$WIFI_PSK" | grep -v '#psk=' \
                >> "$T/etc/wpa_supplicant/wpa_supplicant.conf"
        fi
    fi

    step "Finishing"
    cp "$LOG" "$T/var/log/cig-install.log"; chmod 600 "$T/var/log/cig-install.log"
    sync
    trap - ERR
    cleanup_mounts
    echo
    hr
    echo "cig $VERSION is installed on /dev/$DISK."
    echo "Power off, remove the install media, and boot from that disk."
    hr
}

# ---------------- main ----------------
preflight
load_components
detect_hardware
title "Welcome"
echo "This installs cig $VERSION. You can review everything before anything is written."
echo
pause
until screen_disk; do :; done
until screen_identity; do :; done
screen_components
screen_hardware
screen_security
screen_build
summary
do_install
