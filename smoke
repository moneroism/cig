#
# smoke - cig's package manager.
#
# Every package lives in its own folder:   /usr/pkg/<name>/<version>-<rel>-<id>/
# /usr only contains links into those folders. /etc files are real copies
# (editable); the package folder keeps the pristine version.
# /usr/pkg/INVENTORY lists every installed package and WHY it is there.
#
#   smoke install <pkg>...         install (builds with cigbuild if needed)
#   smoke remove  <pkg>...         remove, then remove dependencies nothing needs
#   smoke autoremove               remove orphaned dependencies
#   smoke list                     installed packages, reason, who needs them
#   smoke why     <pkg>            why a package is installed
#   smoke files   <pkg>            files of a package
#   smoke mark    <reason> <pkg>   set reason: explicit | dependency | build
#   smoke hooks   <pkg>... | --all run a package's setup again (busybox first)
#   smoke audit [--quick]          check the system against the inventory
#                                  (--quick skips the package checksums)
#   smoke adopt                    move packages installed by old cigbuild under smoke

set -euo pipefail
umask 022     # system files are world-readable, whatever the caller's umask is

ROOT="${SMOKE_ROOT:-}"                  # empty = this system; a directory for testing
PKGROOT="$ROOT/usr/pkg"
INV="$PKGROOT/INVENTORY"
CIG_VAR="${CIG_VAR:-/var/cig}"
CIGBUILD="${CIGBUILD:-$(dirname "$(readlink -f "$0")")/cigbuild}"
export CIG_VAR

die()  { echo "!! smoke: $*" >&2; exit 1; }
info() { echo "==> $*"; }
warn() { echo "   ! $*" >&2; }

usage() { sed -n '10,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

# ---------------- inventory ----------------
# One line per package:
#   name  version-rel  reason  depends(comma or -)  package-sha256  folder

inv_init() {
    mkdir -p "$PKGROOT"
    if [ ! -f "$INV" ]; then
        printf '# smoke inventory: every installed package and why it is installed.\n' > "$INV"
        printf '# name version reason depends package-sha256 folder\n' >> "$INV"
        inv_seal
    fi
}
inv_seal()   { sha256sum "$INV" | cut -d' ' -f1 > "$INV.sha256"; }
inv_sealed() { [ -f "$INV.sha256" ] && [ "$(sha256sum "$INV" | cut -d' ' -f1)" = "$(cat "$INV.sha256")" ]; }
inv_line()   { awk -v n="$1" '$1 == n' "$INV" 2>/dev/null || true; }
inv_has()    { [ -n "$(inv_line "$1")" ]; }
inv_field()  { inv_line "$1" | awk -v i="$2" '{ print $i }'; }   # 2=version 3=reason 4=depends 5=sha 6=folder
inv_names()  { { grep -v '^#' "$INV" 2>/dev/null || true; } | awk '{ print $1 }'; }

inv_put() {   # inv_put name version reason depends sha folder
    local tmp="$INV.tmp"
    inv_sealed || die "inventory checksum mismatch - refusing to write (run: smoke audit)"
    { { grep -v '^#' "$INV" || true; } | awk -v n="$1" '$1 != n'; echo "$1 $2 $3 $4 $5 $6"; } \
        | sort > "$tmp.body"
    { grep '^#' "$INV"; cat "$tmp.body"; } > "$tmp"
    rm -f "$tmp.body"; mv -f "$tmp" "$INV"; inv_seal
}
inv_del() {
    local tmp="$INV.tmp"
    inv_sealed || die "inventory checksum mismatch - refusing to write (run: smoke audit)"
    awk -v n="$1" '$1 != n' "$INV" > "$tmp"; mv -f "$tmp" "$INV"; inv_seal
}

# packages whose depends list contains $1
needed_by() {
    { grep -v '^#' "$INV" 2>/dev/null || true; } | awk -v n="$1" '{
        split($4, d, ","); for (i in d) if (d[i] == n) { print $1; break } }'
}

# ---------------- package files ----------------

pkgfile_of() {   # path of the current package file for a recipe; builds it if missing
    local f
    f=$("$CIGBUILD" pkgfile "$1") || die "no recipe for $1"
    if [ ! -f "$f" ]; then "$CIGBUILD" build "$1" >&2; fi    # progress to stderr: stdout is the path
    [ -f "$f" ] || die "building $1 produced no package"
    echo "$f"
}

# read .PKGINFO from an unpacked package (sets pi_* variables)
read_meta() {
    local m="$1/.PKGINFO" name version rel depends config_files link_dirs copy_files
    name= version= rel= depends= config_files= link_dirs= copy_files=
    # shellcheck disable=SC1090
    . "$m"
    pi_name=$name pi_version="$version-$rel" pi_depends=$depends
    pi_config=$config_files pi_linkdirs=$link_dirs pi_copy=$copy_files
    # older packages: take these fields from the recipe
    if ! grep -q '^link_dirs=' "$m"; then
        eval "$("$CIGBUILD" meta "$name" 2>/dev/null || true)"
        pi_config=${config_files:-$pi_config} pi_linkdirs=${link_dirs:-} pi_copy=${copy_files:-}
    fi
}

matches_any() {   # matches_any <path> <glob list>
    local p=$1 g; shift
    for g in $*; do
        # shellcheck disable=SC2254
        case "$p" in $g|$g/*) return 0 ;; esac
    done
    return 1
}

# ---------------- links ----------------

swap_in() {   # swap_in <dst> <command...>: build dst.smoke-new, rename over dst atomically
    local dst=$1; shift
    rm -rf "$dst.smoke-new"
    "$@" "$dst.smoke-new"
    if [ -d "$dst" ] && [ ! -L "$dst" ]; then
        mv "$dst" "$dst.smoke-old"; mv "$dst.smoke-new" "$dst"; rm -rf "$dst.smoke-old"
    elif [ -L "$dst" ] && [ -d "$dst" ]; then
        # a link to a folder: mv would move the new link INTO that folder
        rm -f "$dst"; mv -f "$dst.smoke-new" "$dst"
    else
        mv -f "$dst.smoke-new" "$dst"
    fi
}

# owner of a link in /usr: the package whose folder it points into
link_owner() {
    local t
    t=$(readlink "$1" 2>/dev/null) || return 0
    case "$t" in /usr/pkg/*) echo "$t" | cut -d/ -f4 ;; esac
}

# ---------------- install ----------------

install_pkg() {   # install_pkg <name> <reason>
    local name=$1 reason=$2 f sha id dir D tmp d old oldD rel p dst mypath
    inv_init
    # "keep": rebuilds keep the current reason (explicit for a new install)
    if [ "$reason" = keep ]; then
        if inv_has "$name"; then reason=$(inv_field "$name" 3); else reason=explicit; fi
    fi

    f=$(pkgfile_of "$name")
    sha=$(sha256sum "$f" | cut -d' ' -f1)
    if inv_has "$name" && [ "$(inv_field "$name" 5)" = "$sha" ]; then
        if [ "$reason" = explicit ] && [ "$(inv_field "$name" 3)" != explicit ]; then
            inv_put "$name" "$(inv_field "$name" 2)" explicit "$(inv_field "$name" 4)" "$sha" "$(inv_field "$name" 6)"
            info "$name: now marked explicit"
        fi
        return 0
    fi

    tmp="$CIG_VAR/build/.smoke-$name"
    rm -rf "$tmp"; mkdir -p "$tmp"
    tar -C "$tmp" -xzf "$f"
    read_meta "$tmp"
    [ "$pi_name" = "$name" ] || die "$f contains $pi_name, not $name"

    # dependencies first
    for d in $pi_depends; do
        inv_has "$d" || install_pkg "$d" dependency
    done
    read_meta "$tmp"     # recursion above reused the variables

    # keep the old reason on upgrade (explicit wins)
    if inv_has "$name"; then
        old=$(inv_field "$name" 3)
        [ "$reason" = explicit ] || reason=$old
    fi

    id="$pi_version-${sha:0:8}"
    D="$PKGROOT/$name/$id"
    mypath="/usr/pkg/$name/$id"
    info "$name $pi_version: installing into $mypath"

    # 1. the package folder
    rm -rf "$D.part"; mkdir -p "$D.part/.meta/root"
    [ -d "$tmp/usr" ] && cp -a "$tmp/usr/." "$D.part/"
    cp "$tmp/.PKGINFO" "$D.part/.meta/PKGINFO"
    cp "$tmp/.FILES"   "$D.part/.meta/FILES"
    if [ -f "$tmp/.INSTALL" ]; then cp "$tmp/.INSTALL" "$D.part/.meta/INSTALL"; fi
    printf 'config_files="%s"\nlink_dirs="%s"\ncopy_files="%s"\n' \
        "$pi_config" "$pi_linkdirs" "$pi_copy" > "$D.part/.meta/LAYOUT"
    # pristine copies of everything outside /usr (configs etc.)
    while read -r p; do
        mkdir -p "$D.part/.meta/root/$(dirname "$p")"
        cp -a "$tmp/$p" "$D.part/.meta/root/$p"
    done < <(grep -v '^usr/' "$tmp/.FILES" || true)
    ( cd "$D.part" && find . -path ./.meta -prune -o \( -type f -print \) | sort | xargs -r sha256sum ) \
        > "$D.part/.meta/SUMS"
    rm -rf "$D"; mv "$D.part" "$D"

    # 2. conflicts: a link in /usr that belongs to a different package
    local o
    while read -r p; do
        case "$p" in usr/*) ;; *) continue ;; esac
        dst="$ROOT/$p"
        if [ -L "$dst" ]; then
            o=$(link_owner "$dst")
            if [ -n "$o" ] && [ "$o" != "$name" ] && inv_has "$o"; then
                rm -rf "$D"; die "$name: /$p already belongs to $o"
            fi
        fi
    done < "$tmp/.FILES"

    # 3. links (whole directories for link_dirs, real copies for copy_files)
    local done_dirs=" " g depth top
    while read -r p; do
        case "$p" in usr/*) ;; *) continue ;; esac
        rel=${p#usr/}
        dst="$ROOT/$p"
        top=""
        for g in $pi_linkdirs; do
            depth=$(echo "$g" | awk -F/ '{ print NF }')
            top=$(echo "$p" | cut -d/ -f1-"$depth")
            # shellcheck disable=SC2254
            case "$top" in $g) [ "$top" != "$p" ] && break ;; esac
            top=""
        done
        if [ -n "$top" ]; then
            case "$done_dirs" in *" $top "*) continue ;; esac
            done_dirs="$done_dirs$top "
            mkdir -p "$(dirname "$ROOT/$top")"
            swap_in "$ROOT/$top" ln -s "$mypath/${top#usr/}"
            continue
        fi
        mkdir -p "$(dirname "$dst")"
        if [ -n "$pi_copy" ] && matches_any "$p" $pi_copy; then
            swap_in "$dst" cp -p "$D/$rel"
        else
            swap_in "$dst" ln -s "$mypath/$rel"
        fi
    done < "$tmp/.FILES"

    # 4. files outside /usr: real copies; changed config files are kept
    while read -r p; do
        case "$p" in usr/*) continue ;; esac
        dst="$ROOT/$p"
        mkdir -p "$(dirname "$dst")"
        if [ -f "$dst" ] && [ ! -L "$dst" ] && matches_any "$p" $pi_config \
            && ! cmp -s "$tmp/$p" "$dst"; then
            cp -p "$tmp/$p" "$dst.new"
            warn "$name: /$p was changed locally, kept it. New version: /$p.new"
            continue
        fi
        if [ -L "$tmp/$p" ]; then
            swap_in "$dst" ln -s "$(readlink "$tmp/$p")"
        else
            swap_in "$dst" cp -p "$tmp/$p"
        fi
    done < "$tmp/.FILES"

    # 5. previous build: drop what the new one no longer has, then its folder
    if inv_has "$name"; then
        oldD="$PKGROOT/$name/$(inv_field "$name" 6)"
        if [ -d "$oldD" ] && [ "$oldD" != "$D" ]; then
            grep -vxF -f "$tmp/.FILES" "$oldD/.meta/FILES" | while read -r p; do
                dst="$ROOT/$p"
                case "$p" in
                    usr/*) [ "$(link_owner "$dst")" = "$name" ] && rm -f "$dst" ;;
                    *)     [ -f "$oldD/.meta/root/$p" ] && cmp -s "$oldD/.meta/root/$p" "$dst" && rm -f "$dst" ;;
                esac
            done || true
            rm -rf "$oldD"
        fi
    fi

    inv_put "$name" "$pi_version" "$reason" "$(echo $pi_depends | tr ' ' ',' | sed 's/^$/-/')" "$sha" "$id"
    rm -rf "$tmp"

    if [ -z "$ROOT" ] && [ -f "$D/.meta/INSTALL" ]; then
        bash -c ". '$D/.meta/INSTALL'; post_install" || warn "$name: post_install failed"
    fi
    info "$name $pi_version: installed ($reason)"
}

# ---------------- remove ----------------

remove_pkg() {   # remove_pkg <name> [force]
    local name=$1 force=${2:-} D p dst users
    inv_has "$name" || die "$name is not installed"
    users=$(needed_by "$name" | tr '\n' ' ')
    if [ -n "$users" ] && [ -z "$force" ]; then die "$name is needed by: $users"; fi
    D="$PKGROOT/$name/$(inv_field "$name" 6)"
    info "$name: removing"
    if [ -f "$D/.meta/FILES" ]; then
        local config_files= link_dirs= copy_files=
        . "$D/.meta/LAYOUT" 2>/dev/null || true
        while read -r p; do
            dst="$ROOT/$p"
            case "$p" in
                usr/*)
                    if [ -L "$dst" ] && [ "$(link_owner "$dst")" = "$name" ]; then rm -f "$dst"
                    elif [ -f "$dst" ] && [ ! -L "$dst" ] && cmp -s "$D/${p#usr/}" "$dst"; then rm -f "$dst"   # copy_files
                    fi ;;
                *)
                    if [ -f "$D/.meta/root/$p" ] && cmp -s "$D/.meta/root/$p" "$dst"; then rm -f "$dst"
                    elif [ -e "$dst" ]; then warn "$name: kept /$p (changed locally)"
                    fi ;;
            esac
        done < "$D/.meta/FILES"
        # directory links (link_dirs)
        if [ -n "${link_dirs:-}" ]; then
            find "$ROOT/usr" -path "$ROOT/usr/pkg" -prune -o -type l -print 2>/dev/null | while read -r dst; do
                [ "$(link_owner "$dst")" = "$name" ] && rm -f "$dst"
            done || true
        fi
        # directories that became empty
        sed 's#/[^/]*$##' "$D/.meta/FILES" | sort -ru | while read -r p; do
            case "$p" in usr|etc|var|"") continue ;; esac
            rmdir -p "$ROOT/$p" 2>/dev/null || true
        done
    fi
    rm -rf "$D"; rmdir "$PKGROOT/$name" 2>/dev/null || true
    inv_del "$name"
    info "$name: removed"
}

autoremove() {
    local n changed=1
    while [ $changed -eq 1 ]; do
        changed=0
        for n in $({ grep -v '^#' "$INV" || true; } | awk '$3 == "dependency" { print $1 }'); do
            if [ -z "$(needed_by "$n")" ]; then
                info "$n: no longer needed"
                remove_pkg "$n"; changed=1
            fi
        done
    done
}

# ---------------- queries ----------------

list_pkgs() {
    local n
    printf '%-24s %-22s %-11s %s\n' NAME VERSION REASON NEEDED-BY
    for n in $(inv_names); do
        printf '%-24s %-22s %-11s %s\n' "$n" "$(inv_field "$n" 2)" "$(inv_field "$n" 3)" \
            "$(needed_by "$n" | tr '\n' ' ' | sed 's/ $//')"
    done
}

why_pkg() {
    local n=$1 indent=${2:-} u
    inv_has "$n" || die "$n is not installed"
    echo "$indent$n ($(inv_field "$n" 3))"
    for u in $(needed_by "$n"); do why_pkg "$u" "$indent  needed by "; done
}

files_pkg() {
    inv_has "$1" || die "$1 is not installed"
    sed 's#^#/#' "$PKGROOT/$1/$(inv_field "$1" 6)/.meta/FILES"
}

mark_pkg() {
    case "$1" in explicit|dependency|build) ;; *) die "reason must be explicit, dependency or build" ;; esac
    inv_has "$2" || die "$2 is not installed"
    inv_put "$2" "$(inv_field "$2" 2)" "$1" "$(inv_field "$2" 4)" "$(inv_field "$2" 5)" "$(inv_field "$2" 6)"
    info "$2: marked $1"
}

# ---------------- hooks ----------------

run_hook() {   # run_hook <name>: run the package's post_install (inside $ROOT if set)
    local n=$1 id
    inv_has "$n" || die "$n is not installed"
    id=$(inv_field "$n" 6)
    [ -f "$PKGROOT/$n/$id/.meta/INSTALL" ] || return 0
    info "$n: setup"
    if [ -n "$ROOT" ]; then
        chroot "$ROOT" /bin/bash -c ". /usr/pkg/$n/$id/.meta/INSTALL; post_install"
    else
        bash -c ". /usr/pkg/$n/$id/.meta/INSTALL; post_install"
    fi
}

hooks() {
    local n failed=0
    if [ "${1:-}" = --all ]; then
        # busybox first: its hook creates the command links the others use
        set -- $( { inv_has busybox && echo busybox; inv_names | grep -vx busybox; } || true )
    fi
    for n in "$@"; do run_hook "$n" || { warn "$n: setup failed"; failed=1; }; done
    return $failed
}

# ---------------- audit ----------------

# follow a link inside $ROOT (max 8 hops); prints the final target path without $ROOT
resolve() {
    local p=$1 i t
    for i in 1 2 3 4 5 6 7 8; do
        [ -L "$ROOT$p" ] || { echo "$p"; return; }
        t=$(readlink "$ROOT$p")
        case "$t" in /*) p=$t ;; *) p="$(dirname "$p")/$t" ;; esac
    done
    echo "$p"
}

audit() {
    local quick=${1:-} problems=0 n D p real t i line ign="$ROOT/etc/smoke/audit.ignore"
    local -A INVP OWNER COPYPAT LINK IGN
    flag() { echo "  $*"; problems=$((problems + 1)); }

    echo "smoke audit${quick:+ (quick: package checksums skipped)}"
    echo "-- inventory"
    if [ ! -f "$INV" ]; then echo "  no inventory at /usr/pkg/INVENTORY"; return 1; fi
    inv_sealed || flag "INVENTORY was changed outside smoke (checksum mismatch)"

    # load everything once; lookups below happen inside bash, no process per file
    while read -r n _ _ _ _ D; do
        [ -n "$n" ] && INVP[$n]=$D
    done < <(grep -v '^#' "$INV" || true)
    if [ -f "$ign" ]; then
        while read -r p; do [ -n "$p" ] && IGN[$p]=1; done < <(grep -v '^#' "$ign" || true)
    fi

    echo "-- package folders"
    for D in "$PKGROOT"/*/; do
        [ -d "$D" ] || continue
        n=$(basename "$D")
        if [ -z "${INVP[$n]:-}" ]; then flag "/usr/pkg/$n is not in the inventory (installed outside smoke?)"; continue; fi
        for p in "$D"*/; do
            [ -d "$p" ] || continue
            [ "$(basename "$p")" = "${INVP[$n]}" ] || flag "/usr/pkg/$n/$(basename "$p"): stale build folder"
        done
    done
    i=0
    for n in "${!INVP[@]}"; do
        D="$PKGROOT/$n/${INVP[$n]}"
        [ -d "$D" ] || { flag "$n is in the inventory but its folder is missing"; continue; }
        # file -> owner index, and each package's copy_files patterns
        while read -r p; do OWNER[$p]=$n; done < "$D/.meta/FILES"
        COPYPAT[$n]=$( . "$D/.meta/LAYOUT" 2>/dev/null; echo "${copy_files:-}" )
        if [ -z "$quick" ]; then
            i=$((i + 1)); printf '\r   checking package files: %d/%d %-30s' "$i" "${#INVP[@]}" "$n" >&2
            while read -r line; do
                flag "$n: modified file: ${line%%:*}"
            done < <(cd "$D" && sha256sum -c .meta/SUMS 2>/dev/null | grep -v ': OK$' || true)
        fi
    done
    [ -z "$quick" ] && printf '\r%60s\r' '' >&2

    echo "-- /usr"
    # every link target in one pass
    while IFS= read -r line; do
        LINK[${line%% -> *}]=${line#* -> }
    done < <(find "$ROOT/usr" -path "$ROOT/usr/pkg" -prune -o -type l -exec ls -ld {} + 2>/dev/null \
             | sed -n "s#^.* \\($ROOT/usr/[^ ]*\\) -> \\(.*\\)\$#\\1 -> \\2#p" | sed "s#^$ROOT##")

    while IFS= read -r p; do
        p=${p#"$ROOT"}
        [ -n "${IGN[$p]:-}" ] && continue
        if [ -n "${LINK[$p]+x}" ]; then
            # follow links inside bash (max 8 hops)
            real=$p
            for t in 1 2 3 4 5 6 7 8; do
                [ -n "${LINK[$real]+x}" ] || break
                case "${LINK[$real]}" in /*) real=${LINK[$real]} ;; *) real="${real%/*}/${LINK[$real]}" ;; esac
            done
            case "$real" in
                /usr/pkg/*)
                    n=${real#/usr/pkg/}; n=${n%%/*}
                    [ -n "${INVP[$n]:-}" ] || flag "$p -> $real (package not in inventory)"
                    [ -e "$ROOT$real" ] || flag "$p -> $real (broken link)" ;;
                *)  [ -e "$ROOT$real" ] || flag "$p -> $real (broken link)" ;;
            esac
        else
            n=${OWNER[${p#/}]:-}
            if [ -z "$n" ]; then
                flag "$p: not managed by any package"
            elif ! matches_any "${p#/}" ${COPYPAT[$n]}; then
                flag "$p: real file where $n installs a link (replaced?)"
            fi
        fi
    done < <(find "$ROOT/usr" -path "$ROOT/usr/pkg" -prune -o \( -type f -o -type l \) -print 2>/dev/null | sort)

    echo "-- /etc (changed configuration, for information)"
    for n in "${!INVP[@]}"; do
        D="$PKGROOT/$n/${INVP[$n]}"
        [ -d "$D/.meta/root/etc" ] || continue
        while read -r p; do
            if [ ! -e "$ROOT/$p" ]; then echo "  /$p ($n): missing"
            elif ! cmp -s "$D/.meta/root/$p" "$ROOT/$p"; then echo "  /$p ($n): changed"
            fi
        done < <(cd "$D/.meta/root" && find etc -type f)
    done

    echo "-- orphans"
    for n in $({ grep -v '^#' "$INV" || true; } | awk '$3 == "dependency" { print $1 }'); do
        [ -n "$(needed_by "$n")" ] || echo "  $n (nothing needs it; smoke autoremove)"
    done

    if [ $problems -eq 0 ]; then echo "audit: clean"; else echo "audit: $problems problem(s)"; return 1; fi
}

# ---------------- adopt (migration from the old cigbuild database) ----------------

adopt() {
    local db="$ROOT/var/cig/db" n deps all leaves=""
    [ -d "$db" ] || die "no old database at /var/cig/db"
    inv_init
    all=$(ls "$db")
    # explicit = packages no other installed package depends on
    for n in $all; do
        local used=0 o
        for o in $all; do
            [ "$o" = "$n" ] && continue
            deps=$( . "$db/$o/PKGINFO"; echo " $depends " )
            case "$deps" in *" $n "*) used=1; break ;; esac
        done
        [ $used -eq 0 ] && leaves="$leaves $n"
    done
    info "explicit:$leaves"
    for n in $all; do
        case " $leaves " in *" $n "*) install_pkg "$n" explicit ;; *) install_pkg "$n" dependency ;; esac
    done
    mv "$db" "$db.adopted"
    info "adopted $(echo "$all" | wc -w) packages. Old database kept at /var/cig/db.adopted"
    info "run: smoke audit"
}

# ---------------- main ----------------

[ "$(id -u)" -eq 0 ] || [ -n "$ROOT" ] || case "${1:-}" in list|why|files|audit|installed|"") ;; *) die "run as root" ;; esac

cmd=${1:-}; shift || true
case "$cmd" in
    install)    [ $# -gt 0 ] || usage
                reason=explicit
                case "${1:-}" in --as) reason=$2; shift 2 ;; esac
                for p in "$@"; do install_pkg "$p" "$reason"; done ;;
    remove)     [ $# -gt 0 ] || usage; for p in "$@"; do remove_pkg "$p"; done; autoremove ;;
    autoremove) autoremove ;;
    list)       list_pkgs ;;
    why)        [ $# -eq 1 ] || usage; why_pkg "$1" ;;
    files)      [ $# -eq 1 ] || usage; files_pkg "$1" ;;
    mark)       [ $# -eq 2 ] || usage; mark_pkg "$1" "$2" ;;
    audit)      case "${1:-}" in --quick) audit quick ;; "") audit ;; *) usage ;; esac ;;
    adopt)      adopt ;;
    hooks)      [ $# -gt 0 ] || usage; hooks "$@" ;;
    installed)  [ $# -eq 1 ] || usage; inv_has "$1" ;;      # for cigbuild
    *)          usage ;;
esac
